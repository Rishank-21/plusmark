---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/primitives.css';
import '../styles/shell.css';
import '../styles/swatches.css';
import '../styles/cart.css';
import '../styles/experiments.css';
import Header from '../components/shell/Header.astro';
import BottomNav from '../components/shell/BottomNav.astro';
import Footer from '../components/shell/Footer.astro';
import HindiPrompt from '../components/shell/HindiPrompt.astro';
import ConsentBanner from '../components/shell/ConsentBanner.astro';
import QuickView from '../components/plp/QuickView.astro';
import { loadShellData, type ShellData } from '../lib/shell-data';
import { loadPdpData } from '../lib/pdp-data';
import { resolveLayout } from '../lib/presets';
import { dir, t, type Locale } from '../lib/i18n';
import { EXPERIMENTS_BLOCK_ID, HEAD_SCRIPT, experimentsJson, normalizeExperiments } from '../lib/head-script';
import { alternateLinks, canonicalUrl } from '../lib/lang-path';
import { jsonLdText, metaDescription, robotsContent, socialTags } from '../lib/seo';

interface Props {
  title: string;
  locale?: Locale;
  description?: string;
  /** Path of this page (default: the request path), used for canonical and hreflang links. */
  path?: string;
  /** Set false for a page with no version in the other language. */
  alternates?: boolean;
  /** True on a page with a bottom action bar (Cart, checkout, PDP with the Sticky_Buy_Bar): the bottom navigation hides. */
  bottomBar?: boolean;
  /** Header and footer data; defaults to the build's read. */
  shell?: ShellData;
  /** True for a page that search engines should not index (Req 20.2). */
  noindex?: boolean;
  /** Main image for the social cards (Req 20.7); defaults to the store logo. */
  image?: string;
  /** Structured data objects, written as JSON-LD (Req 20.3-20.5). */
  jsonLd?: unknown[];
  ogType?: 'website' | 'product';
}
const { title, locale = 'en', description, path = Astro.url.pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '') || '/', alternates = true, bottomBar = false, shell = loadShellData(), noindex = false, image, jsonLd = [], ogType = 'website' } = Astro.props;
// The build data step writes the running Experiments to src/data/experiments.json; without it there are none.
const experimentFiles = import.meta.glob<unknown>('../data/experiments.json', { eager: true, import: 'default' });
const experiments = normalizeExperiments(Object.values(experimentFiles)[0]);
const canonical = canonicalUrl(path, Astro.site);
const links = alternates ? alternateLinks(path, Astro.site) : [];
// Every page has a description built from its own data; the title stands in when a page gives none (Req 20.1).
const metaDesc = metaDescription(description ?? '', title);
const robots = robotsContent(noindex);
const cardImage = image ?? shell.brand.logoUrl;
const absolute = (u: string | undefined) => (u && Astro.site && !/^https?:\/\//.test(u) ? new URL(u, Astro.site).href : u);
const cards = socialTags({ title, description: metaDesc, image: absolute(cardImage), url: canonical, type: ogType, locale, siteName: shell.brand.name });
// The applied Business_Preset: the grocery one adds the card stepper and the Buy again rail (Req 6.9).
const presetKey = resolveLayout(loadPdpData().settings).preset;
---
<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/json" id={EXPERIMENTS_BLOCK_ID} set:html={experimentsJson(experiments)}></script>
    <script is:inline set:html={HEAD_SCRIPT}></script>
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    {robots && <meta name="robots" content={robots} />}
    {cards.map((c) => (c.attr === 'property' ? <meta property={c.key} content={c.content} /> : <meta name={c.key} content={c.content} />))}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={jsonLdText(d)}></script>)}
    <link rel="canonical" href={canonical} />
    {links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="stylesheet" href="/brand.css" />
  </head>
  <body data-bottom-bar={bottomBar ? '' : undefined} data-preset={presetKey ?? undefined}>
    <a class="pm-skip-link" href="#main">{t(locale, 'a11y.skipToContent')}</a>
    <Header locale={locale} pathname={path} shell={shell} />
    <main id="main" tabindex="-1" aria-label={t(locale, 'landmarks.main')}>
      <slot />
    </main>
    <Footer locale={locale} pathname={path} shell={shell} />
    <BottomNav locale={locale} pathname={path} />
    {locale === 'en' && <HindiPrompt pathname={path} />}
    <ConsentBanner locale={locale} pathname={path} />
    <QuickView locale={locale} />
    <div id="pm-live" class="pm-visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/ui';
      import '../scripts/shell';
      import '../scripts/consent';
      import '../scripts/cart';
      import '../scripts/events';
      import '../scripts/experiments';
      import '../scripts/vitals';
      import '../scripts/marketing';
    </script>
  </body>
</html>
