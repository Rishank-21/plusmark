---
// One Product_Card per product, with swatches instead of one card per variant (Req 8.2, 8.3).
// data-live-product lets live-client refresh price and availability; data-add-to-cart marks the quick-add control.
// The anatomy follows the reference listing: a square image stage with the badges and the save control on it,
// then the title, and a footer that pins the price and the action to the bottom of the card.
import Picture from '../ui/Picture.astro';
import Badge from '../ui/Badge.astro';
import Price from '../ui/Price.astro';
import { priceParts, productPath, type CardData, type CardLabels } from '../../lib/plp-card';
import type { ImageSource } from '../../lib/images';
import SaveButton from '../requests/SaveButton.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  card: CardData;
  locale: Locale;
  labels: CardLabels;
  /** The build's processed image of the product's first image; without it the original URL is used. */
  image?: ImageSource;
  /** True for the first row's first card: it gets high fetch priority (Req 3.5). */
  priority?: boolean;
}
const { card, locale, labels, image, priority = false } = Astro.props;
const href = productPath(card.handle, locale);
const pp = priceParts(card, locale, labels);
---
<li class="pm-card pm-product-card" data-live-product={card.id} data-product-id={card.id}>
  <div class="pm-card__media">
    <a class="pm-card__link" href={href} tabindex="-1" aria-hidden="true"></a>
    {image
      ? <Picture image={{ ...image, alt: '' }} slot="card" priority={priority} class="pm-card__picture" />
      : card.imageUrl
        ? <img class="pm-card__img" src={card.imageUrl} width="480" height="480" alt="" loading={priority ? undefined : 'lazy'} decoding={priority ? undefined : 'async'} fetchpriority={priority ? 'high' : undefined} />
        : <span class="pm-card__img pm-card__img--empty" aria-hidden="true"></span>}
    {card.badges.length > 0 && (
      <ul class="pm-card__badges">
        {card.badges.map((b) => <li><Badge>{labels.badges[b] ?? b}</Badge></li>)}
      </ul>
    )}
    <SaveButton productId={card.id} title={card.title} locale={locale} />
    <button
      type="button"
      class="pm-card__quick"
      data-pm-quick-view
      data-quick-title={card.title}
      data-quick-url={href}
      data-quick-image={card.imageUrl ?? ''}
      data-quick-price={pp.current}
      data-quick-prior={pp.prior ?? undefined}
      data-quick-badges={card.badges.map((b) => labels.badges[b] ?? b).join('|')}
      data-quick-product-id={card.price !== null && card.singleVariantId ? card.id : undefined}
      data-quick-variant-id={card.price !== null && card.singleVariantId ? card.singleVariantId : undefined}
      data-quick-add={labels.addToCart}
      data-quick-full={labels.viewFull}
      aria-label={t(locale, 'plp.quickViewFor', { title: card.title })}
    >{labels.quickView}</button>
  </div>
  <div class="pm-card__body">
    <h3 class="pm-card__title"><a href={href}>{card.title}</a></h3>
    {card.swatches.length > 0 && (
      <ul class="pm-swatches" aria-label={card.swatches.map((s) => s.value).join(', ')}>
        {card.swatches.map((s) => (
          <li class="pm-swatch" title={s.value} data-colour={s.css ?? undefined}>{s.css ? '' : s.value.slice(0, 2)}</li>
        ))}
        {card.extraSwatches > 0 && <li class="pm-swatch pm-swatch--more">{labels.moreColours.replace('{count}', String(card.extraSwatches))}</li>}
      </ul>
    )}
    <div class="pm-card__foot">
      <p class="pm-card__price">
        {pp.from && <span class="pm-card__from">{labels.from} </span>}
        <Price>
          <span class="pm-card__now">
            <span class="pm-visually-hidden">{labels.srCurrent.replace('{price}', pp.current)}</span>
            <span aria-hidden="true">{pp.current}</span>
          </span>
          {pp.prior && (
            <s class="pm-card__prior">
              <span class="pm-visually-hidden">{labels.srPrior.replace('{price}', pp.prior)}</span>
              <span aria-hidden="true">{pp.prior}</span>
            </s>
          )}
        </Price>
        {pp.saving && <span class="pm-card__saving"> {pp.saving}</span>}
      </p>
      <p class="pm-unavailable-note" data-unavailable-note data-product-id={card.id} hidden>{labels.unavailable}</p>
      {card.singleVariantId && card.price !== null
        ? <button type="button" class="pm-button pm-button--secondary pm-card__add" data-add-to-cart data-product-id={card.id} data-variant-id={card.singleVariantId}>{labels.addToCart}</button>
        : <a class="pm-button pm-button--secondary pm-card__add" href={href}>{labels.chooseOptions}</a>}
    </div>
  </div>
</li>
