---
// Footer (Req 7.9): policy links, Seller_Details summary, Grievance_Officer, Ranking_Disclosure, Compliance_Certificate,
// contact page, privacy choices, language switch and the PIN code data credit.
import { t, type Locale } from '../../lib/i18n';
import { alternatePath, localizePath, otherLocale } from '../../lib/shell-nav';
import type { ShellData } from '../../lib/shell-data';
import NewsletterForm from '../requests/NewsletterForm.astro';

interface Props { locale: Locale; pathname: string; shell: ShellData }
const { locale, pathname, shell } = Astro.props;
const other = otherLocale(locale);
const { seller, grievanceOfficer } = shell;
const POLICIES = ['returns', 'refunds', 'exchanges', 'cancellations', 'shipping', 'payments', 'warranties', 'privacy', 'terms'];
const year = new Date().getFullYear();
const page = (path: string) => localizePath(locale, path);
const hasSellerDetails = Object.values(seller).some(Boolean) || Object.values(grievanceOfficer).some(Boolean);
---
<footer class="pm-footer" aria-label={t(locale, 'landmarks.footer')}>
  <div class="pm-container pm-footer__grid">
    <section aria-labelledby="pm-footer-policies">
      <h2 id="pm-footer-policies" class="pm-footer__heading">{t(locale, 'footer.policies')}</h2>
      <ul class="pm-footer__list">
        {POLICIES.map((slug) => (
          <li><a class="pm-link" href={page(`/policies/${slug}`)}>{t(locale, `footer.policy.${slug}`)}</a></li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="pm-footer-help">
      <h2 id="pm-footer-help" class="pm-footer__heading">{t(locale, 'footer.help')}</h2>
      <ul class="pm-footer__list">
        <li><a class="pm-link" href={page('/contact')}>{t(locale, 'footer.contact')}</a></li>
        <li><a class="pm-link" href={page('/seller')}>{t(locale, 'footer.sellerPage')}</a></li>
        <li><a class="pm-link" href={page('/ranking-disclosure')}>{t(locale, 'footer.ranking')}</a></li>
        <li><a class="pm-link" href="/why">{t(locale, 'footer.why')}</a></li>
        <li><a class="pm-link" href={page('/compliance-certificate')}>{t(locale, 'footer.certificate')}</a></li>
        <li><a class="pm-link" href={page('/policies/privacy#choices')} data-pm-privacy-choices>{t(locale, 'footer.privacyChoices')}</a></li>
        <li><a class="pm-link" href={alternatePath(locale, pathname)} hreflang={other} lang={other} data-pm-lang-switch>{t(locale, 'nav.otherLanguageName')}</a></li>
      </ul>
    </section>
    {hasSellerDetails && (
      <section aria-labelledby="pm-footer-seller">
        <h2 id="pm-footer-seller" class="pm-footer__heading">{t(locale, 'footer.seller')}</h2>
        <p class="pm-footer__text"><strong>{seller.legalName}</strong><br />{seller.registeredAddress}</p>
        <dl class="pm-footer__facts">
          {seller.gstin && <div><dt>{t(locale, 'footer.gstin')}</dt><dd>{seller.gstin}</dd></div>}
          {(seller.customerCarePhone || seller.customerCareEmail) && <div><dt>{t(locale, 'footer.care')}</dt><dd>{seller.customerCarePhone && <a href={`tel:${seller.customerCarePhone.replace(/[^+\d]/g, '')}`}>{seller.customerCarePhone}</a>}{seller.customerCarePhone && seller.customerCareEmail ? ', ' : ''}{seller.customerCareEmail && <a href={`mailto:${seller.customerCareEmail}`}>{seller.customerCareEmail}</a>}</dd></div>}
          {(grievanceOfficer.name || grievanceOfficer.designation || grievanceOfficer.phone || grievanceOfficer.email) && <div><dt>{t(locale, 'footer.grievance')}</dt><dd>{[grievanceOfficer.name, grievanceOfficer.designation].filter(Boolean).join(', ')}{(grievanceOfficer.name || grievanceOfficer.designation) && (grievanceOfficer.phone || grievanceOfficer.email) ? ', ' : ''}{grievanceOfficer.phone && <a href={`tel:${grievanceOfficer.phone.replace(/[^+\d]/g, '')}`}>{grievanceOfficer.phone}</a>}{grievanceOfficer.phone && grievanceOfficer.email ? ', ' : ''}{grievanceOfficer.email && <a href={`mailto:${grievanceOfficer.email}`}>{grievanceOfficer.email}</a>}</dd></div>}
        </dl>
      </section>
    )}
  </div>
  <div class="pm-container">
    <NewsletterForm locale={locale} />
  </div>
  <div class="pm-container pm-footer__legal">
    <p>{t(locale, 'footer.pinCredit')}</p>
    <p>{t(locale, 'footer.copyright').replace('{year}', String(year)).replace('{name}', shell.brand.name)}</p>
  </div>
</footer>
