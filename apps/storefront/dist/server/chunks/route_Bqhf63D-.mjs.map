---
import RequestSection from './RequestSection.astro';
import FormEnd from './FormEnd.astro';
import { rq } from '../../lib/requests/page-data';
import { localizePath } from '../../lib/shell-nav';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; productId: string }
const { locale, productId } = Astro.props;
const id = 'pm-review-form';
---
<RequestSection locale={locale} id={id} heading={rq(locale, 'rev.heading')} signInPath={localizePath(locale, '/sign-in')}>
  <p data-pm-signin-note hidden>{rq(locale, 'rev.signIn')} <a class="pm-link" data-pm-signin-link href={localizePath(locale, '/sign-in')}>{rq(locale, 'rev.signInLink')}</a></p>
  <form class="pm-request__form" data-pm-form data-action="submit_review" data-product-id={productId} data-needs-session novalidate>
    <fieldset class="pm-request__rating">
      <legend class="pm-label">{rq(locale, 'rev.rating')}</legend>
      {[5, 4, 3, 2, 1].map((n) => (
        <label class="pm-request__star"><input type="radio" name="rating" value={String(n)} required /> {'★'.repeat(n)}<span class="pm-visually-hidden"> {rq(locale, 'rev.star', { n })}</span></label>
      ))}
    </fieldset>
    <div class="pm-field"><label class="pm-label" for={`${id}-title`}>{rq(locale, 'rev.title')}</label>
      <input class="pm-input" id={`${id}-title`} name="title" maxlength="120" autocomplete="off" /></div>
    <div class="pm-field"><label class="pm-label" for={`${id}-body`}>{rq(locale, 'rev.body')}</label>
      <textarea class="pm-input" id={`${id}-body`} name="body" rows="5" maxlength="4000" required></textarea></div>
    <FormEnd locale={locale} submit={rq(locale, 'rev.submit')} />
  </form>
  <div class="pm-request__done" data-pm-done hidden></div>
</RequestSection>
