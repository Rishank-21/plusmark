---
// Wrapper of one request form: heading, the form, the confirmation and the status line (Req 15, 11.16, 21.4).
import '../../styles/requests.css';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; id: string; heading?: string; intro?: string; signInPath?: string }
const { locale, id, heading, intro, signInPath } = Astro.props;
---
<section class="pm-request" id={id} aria-labelledby={heading ? `${id}-h` : undefined} data-pm-requests data-locale={locale} data-signin-path={signInPath}>
  {heading && <h2 id={`${id}-h`} class="pm-request__heading">{heading}</h2>}
  {intro && <p class="pm-request__intro">{intro}</p>}
  <slot />
  <p class="pm-request__status" data-pm-status role="status" aria-live="polite" hidden></p>
</section>
<script>
  import '../../scripts/requests';
</script>
