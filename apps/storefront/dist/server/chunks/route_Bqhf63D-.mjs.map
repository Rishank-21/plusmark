---
// PDP (Req 9, 10.10). Order: gallery, name, Review_Summary, price block, offers, service information, variant selectors,
// stock and delivery, Buy_Box actions, order facts, Trust_Strip, Key_Highlights, PDP_Blocks, reviews, up to 2 rails.
// The buying area is one Live_Island (PdpBuyBox); the gallery, blocks, share control and review filters are plain HTML
// moved by scripts/pdp.ts.
import '../../styles/pdp.css';
import Container from '../ui/Container.astro';
import Picture from '../ui/Picture.astro';
import Icon from '../ui/Icon.astro';
import ProductCard from '../plp/ProductCard.astro';
import PdpSummary from '../legal/PdpSummary.astro';
import Declarations from '../legal/Declarations.astro';
import PdpBuyBox from '../../persuasion/PdpBuyBox';
import ExperimentSlot from '../persuasion/ExperimentSlot.astro';
import { experimentSlots } from '../../persuasion/switch';
import { loadExperiments } from '../../lib/experiments';
import { pdpBlockShows } from '../../lib/presets';
import PdpGoesWell from '../../persuasion/PdpGoesWell';
import PdpAlerts from '../requests/PdpAlerts.astro';
import PdpRequests from '../requests/PdpRequests.astro';
import SaveButton from '../requests/SaveButton.astro';
import { ReviewHighlights, ReviewSummary, TrustStrip } from '../../persuasion/SocialProof';
import { priceBlockLabels } from '../../persuasion/price-labels';
import { deliveryLabels, countdownLabels } from '../../persuasion/delivery-labels';
import { socialLabels } from '../../persuasion/social-labels';
import { journeyLabels } from '../../persuasion/journey-labels';
import { t, type Locale } from '../../lib/i18n';
import { pdpText, pt } from '../../lib/pdp-text';
import { sanitizeHtml } from '../../lib/sanitize';
import { localizePath } from '../../lib/shell-nav';
import { buildLiveUrl } from '../../lib/live-client';
import { formatDate, formatMoney } from '../../lib/format';
import { blockView, blocksToShow, claimedAttributes, isPriceOnRequest, type BlockView } from '../../lib/pdp-blocks';
import { cardOf, productPath } from '../../lib/plp-card';
import { cardLabels } from '../../lib/plp-labels';
import {
  categoryChain, categoryPath, componentSwitches, offersFor, parsePdpProduct, parsePdpReviews, ratingDistribution, sortReviews,
  type CategoryRow, type PdpModel,
} from '../../lib/pdp';
import type { ImageSource } from '../../lib/images';
import type { TrustEvidence } from '../../lib/social-proof';

interface Props {
  locale: Locale;
  product: Record<string, unknown>;
  /** All products of the build, for the paired and related rails. */
  catalog: Record<string, unknown>[];
  categories: CategoryRow[];
  settings: Record<string, unknown>;
  offers: unknown;
  rules: Record<string, unknown>;
  currency: string;
  regionId: string | null;
  reviews: { enabled: boolean; reviews: unknown };
  badgePriority?: string[];
  /** The preset's unit-price rule (Req 10.5). */
  requireUnitPrice?: boolean;
  /** PDP_Block keys in the store's order; empty shows the default blocks (Req 6.6). */
  pdpBlocks?: string[];
}
const { locale, product, catalog, categories, settings, offers, rules, currency, regionId, reviews, badgePriority = [], requireUnitPrice = false, pdpBlocks = [] } = Astro.props;
const model = parsePdpProduct(product, currency) as PdpModel;
const text = pdpText(locale);
const switches = componentSwitches(settings);
// A component with a running Experiment renders in the other state and shows to one variant only (ExperimentSlot).
const slots = experimentSlots(switches, loadExperiments());
const on = (k: string) => slots.render[k] !== false;
const liveUrl = buildLiveUrl({ ids: [model.id], region: regionId, channel: null, currency: currency.toLowerCase() });
const num = (x: unknown): number | null => (typeof x === 'number' && Number.isFinite(x) ? x : null);

const images: ImageSource[] = model.images.map((i, n) => ({
  id: i.id || `img-${n}`, hash: '', width: 800, height: 800, originalUrl: i.url, alt: n === 0 ? model.title : `${model.title} ${n + 1}`,
}));

// Breadcrumbs: home, the category chain, the product (Req 7.8).
const firstCat = model.categories[0];
const chain = firstCat ? categoryChain(categories, firstCat.id) : [];
const crumbs = [
  { label: t(locale, 'plp.home'), href: localizePath(locale, '/') },
  ...chain.map((c) => ({ label: c.name, href: localizePath(locale, `/shop/${categoryPath(categories, c.id)}`) })),
  { label: model.title, href: '' },
];

// Declarations apply to the variant when the product has one.
const soleVariantId = model.variants.length === 1 ? model.variants[0].id : null;
const declarationProduct = {
  attributes: model.attributes as { key: string; value: unknown }[],
  declarations: (product.declarations ?? {}) as Record<string, never>,
};

const sellerDetails = (settings['storefront.seller_details'] ?? {}) as Record<string, unknown>;
const sellerText = (key: string): string => (typeof sellerDetails[key] === 'string' ? String(sellerDetails[key]).trim() : '');
const returnDays = Number(model.attributes.find((a) => a.key === 'return_days')?.value);
const trust: TrustEvidence = {
  returnDays: Number.isInteger(returnDays) && returnDays > 0 ? returnDays : null,
  gstInvoice: sellerText('gstin') !== '' ? true : undefined,
  origin: model.originCountry || null,
};

// The order facts of the purchase panel. A blank setting falls back to what the storefront already publishes.
const facts = {
  shipsFrom: sellerText('registered_address') ? `${text.soldBy}: ${sellerText('registered_address')}` : text.shipsFromValue,
  soldBy: sellerText('legal_name') || text.soldByValue,
};

// Offers with their conditions (Req 10.10), then the standing order terms of the shop.
const offerRows = offersFor(offers, (type, value, cur) =>
  type === 'percentage' ? pt(locale, 'offerPercent', { value }) : pt(locale, 'offerAmount', { amount: formatMoney(value, cur, locale) }));
const STANDING_OFFERS = [
  { title: text.offerGstTitle, body: text.offerGstBody },
  { title: text.offerBulkTitle, body: text.offerBulkBody },
  { title: text.offerCustomTitle, body: text.offerCustomBody },
];

// Service information: the six facts that answer "will this reach me, and can I buy one?".
const SERVICES = [
  { icon: 'truck', label: text.serviceDispatch },
  { icon: 'pin', label: text.servicePickup },
  { icon: 'invoice', label: text.serviceGst },
  { icon: 'cart', label: text.serviceSingle },
  { icon: 'medal', label: text.serviceBulk },
  { icon: 'phone', label: text.serviceSupport },
] as const;

// Key_Highlights, at most 5 (Req 9.8).
const highlights = model.keyHighlights.slice(0, 5);

// PDP_Blocks: the description, then the specifications that have data.
const HIDDEN_ATTRS = new Set(['key_highlights', 'return_days', 'country_of_origin', 'manufacturer', 'importer', 'generic_name', 'consumer_care']);
const specText = (v: unknown): string => (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean' ? String(v).trim() : '');
// Attributes that a listed preset block shows are not repeated in the specifications.
const claimed = pdpBlocks.length > 0 ? claimedAttributes(pdpBlocks) : new Set<string>();
const storyKey = /^product_story_(\d+)$/;
const storyPhotos = model.attributes.filter(a => storyKey.test(a.key) && typeof a.value === 'string' && a.value.startsWith('https://res.cloudinary.com/'))
  .sort((a,b) => Number(a.key.slice(14)) - Number(b.key.slice(14)));
const specs = model.attributes.map((a) => ({ key: a.key, value: specText(a.value) })).filter((a) => a.value && !storyKey.test(a.key) && !HIDDEN_ATTRS.has(a.key) && !claimed.has(a.key));
const descriptionHtml = model.description ? sanitizeHtml(model.description) : '';

// Preset PDP_Blocks, in the store's order and only with data (Req 6.6, 6.7). The comparison block reads the paired products.
const priceOnRequest = pdpBlocks.includes('quotation_request') && isPriceOnRequest(model);
const compared = new Map<string, PdpModel>();
for (const h of model.pairings.comparison ?? []) {
  const raw = catalog.find((p) => p.handle === h);
  const parsed = raw ? parsePdpProduct(raw, currency) : null;
  if (parsed) compared.set(h, parsed);
}
const blockCtx = { model, byHandle: compared, formatDate: (iso: string) => formatDate(iso, locale), priceOnRequest };
const blockList = blocksToShow(pdpBlocks);
const presetBlocks = new Map<string, BlockView>();
for (const key of blockList) {
  const view = blockView(key, blockCtx);
  if (view) presetBlocks.set(key, view);
}
const blockTitle = (key: string): string => (text as Record<string, string>)[`block_${key}`] ?? key.replace(/[_-]+/g, ' ');
const rowLabel = (key: string): string => /^size_\d/.test(key)
  ? key.slice(5).replace(/(\d)p(?=\d)/g, '$1.').replace(/_x_/g, ' × ').replace(/_/g, ' ')
  : key.replace(/[_-]+/g, ' ');
const rowValue = (r: { value: string; boolean?: boolean }): string => (r.boolean ? (r.value === 'true' ? text.yes : text.no) : r.value);
const quoteHref = (kind: 'quotation' | 'enquiry') => `${localizePath(locale, '/contact')}?${kind}=${encodeURIComponent(model.handle)}#${kind}`;

// Delivery charge rules and the Cash_On_Delivery fee (Req 10.7).
const threshold = num(rules.free_delivery_threshold);
const cod = (rules.cod ?? {}) as Record<string, unknown>;
const codFee = num(cod.fee);
const ruleLines = [
  ...(threshold && threshold > 0 ? [pt(locale, 'freeDeliveryAbove', { amount: formatMoney(threshold, currency, locale) })] : []),
  ...(cod.max_order_amount !== undefined && codFee !== null ? [codFee > 0 ? pt(locale, 'codFee', { amount: formatMoney(codFee, currency, locale) }) : pt(locale, 'codFree')] : []),
];

// Reviews (Req 9.12).
const reviewList = sortReviews(parsePdpReviews(reviews.reviews), 'newest');
const dist = ratingDistribution(reviewList);
const reviewSummaryEvidence = model.rating ? { count: model.rating.count, average: model.rating.average } : null;

// Rails: Goes_Well_With from the store's pairings, and one more of the same category; each needs 2 or more products.
const byHandle = new Map(catalog.map((p) => [String(p.handle), p]));
const pairedProducts = (model.pairings.goes_well_with ?? []).map((h) => byHandle.get(h)).filter((p): p is Record<string, unknown> => !!p)
  .map((p) => cardOf(p, { badgePriority, now: 0 })).filter((c) => c !== null)
  .map((c) => ({ id: c.id, title: c.title, price: c.price ?? 0, available: c.price !== null, url: productPath(c.handle, locale), variantId: c.singleVariantId }));
const showPaired = on('goes_well_with') && pairedProducts.length >= 2;
const pairedIds = new Set(pairedProducts.map((p) => p.id));
const related = catalog
  .filter((p) => p.id !== model.id && !pairedIds.has(String(p.id)) && Array.isArray(p.categories) && (p.categories as { id?: string }[]).some((c) => model.categories.some((m) => m.id === c.id)))
  .slice(0, 4).map((p) => cardOf(p, { badgePriority, now: 0 })).filter((c) => c !== null);
const labels = cardLabels(locale);

// The island needs the product without its long fields.
const slim = { ...model, description: '', images: [], attributes: [], pairings: {}, keyHighlights: [], categories: [] };
const stickyOn = on('sticky_buy_bar');
---
<Container class="pm-product-shell">
  <div class="pm-pdp" data-pdp data-handle={model.handle} data-product-id={model.id} data-sticky={stickyOn ? '' : undefined}>
    <nav aria-label={text.breadcrumbs} class="pm-breadcrumbs">
      <ol>
        {crumbs.map((b, i) => (
          <li>{i < crumbs.length - 1 ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}</li>
        ))}
      </ol>
    </nav>

    <div class="pm-pdp__top">
      <section class="pm-gallery" aria-roledescription="carousel" aria-label={text.galleryLabel} data-gallery data-position-text={text.position}>
        {images.length > 0 ? (
          <>
            <ul class="pm-gallery__track" data-gallery-track tabindex="0">
              {images.map((img, i) => (
                <li class="pm-gallery__slide" data-full={img.originalUrl} data-alt={img.alt} aria-roledescription="slide" aria-label={pt(locale, 'position', { index: i + 1, total: images.length })}>
                  <Picture image={img} slot="gallery" priority={i === 0} class="pm-gallery__img" />
                </li>
              ))}
            </ul>
            <button type="button" class="pm-gallery__btn pm-gallery__btn--prev" data-gallery-prev aria-label={text.prev} hidden={images.length < 2}>‹</button>
            <button type="button" class="pm-gallery__btn pm-gallery__btn--next" data-gallery-next aria-label={text.next} hidden={images.length < 2}>›</button>
            <p class="pm-gallery__pos" data-gallery-pos aria-live="polite">{pt(locale, 'position', { index: 1, total: images.length })}</p>
            <button type="button" class="pm-gallery__open" data-gallery-open>{text.open}</button>
            {images.length > 1 && (
              <ul class="pm-gallery__thumbs">
                {images.map((img, i) => (
                  <li><button type="button" class="pm-gallery__thumb" data-gallery-thumb={i} aria-label={pt(locale, 'showImage', { index: i + 1 })} aria-current={i === 0 ? 'true' : undefined}><img src={img.originalUrl} width="60" height="60" loading="lazy" alt="" /></button></li>
                ))}
              </ul>
            )}
            <div class="pm-share" data-share data-title={model.title} data-copied={text.copied}>
              <button type="button" class="pm-button pm-button--secondary" data-share-button aria-label={text.share}>{text.share}</button>
              <div class="pm-share__fallback" data-share-fallback hidden>
                <button type="button" class="pm-link" data-share-copy>{text.copyLink}</button>
                <a class="pm-link" data-share-whatsapp href="https://wa.me/" target="_blank" rel="noopener noreferrer">{text.whatsapp}</a>
              </div>
              <p class="pm-share__status" role="status" data-share-status></p>
            </div>
          </>
        ) : (
          <p class="pm-gallery__none">{text.noImage}</p>
        )}
      </section>

      <div class="pm-commerce-layout">
        <div class="pm-reference-title">
          <h1 class="pm-pdp__title">{model.title}</h1>
          <a class="pm-pdp__store" href={localizePath(locale, '/shop')}>{text.visitStore}</a>
          <ExperimentSlot component="review_summary" showTo={slots.showTo.review_summary}><ReviewSummary locale={locale} labels={socialLabels(locale)} evidence={reviewSummaryEvidence} switchOn={on('review_summary')} /></ExperimentSlot>
        </div>

        <PdpBuyBox
          client:load
          locale={locale}
          text={text}
          model={slim}
          liveUrl={liveUrl}
          switches={slots.render}
          showTo={slots.showTo}
          requireUnitPrice={requireUnitPrice}
          priceOnRequest={priceOnRequest}
          requestLinks={priceOnRequest ? { quotation: quoteHref('quotation'), enquiry: quoteHref('enquiry') } : null}
          labels={{ price: priceBlockLabels(locale), delivery: deliveryLabels(locale), countdown: countdownLabels(locale), social: socialLabels(locale), journey: journeyLabels(locale) }}
          freeDeliveryThreshold={threshold}
          countryCode="in"
          facts={facts}
          totalLabel={text.totalFor}
          panelNote={text.panelNote}
        >
          <section class="pm-ref-offers" aria-labelledby="pdp-offers-heading" data-rail>
            <div class="pm-ref-head">
              <h2 id="pdp-offers-heading">{text.offers}</h2>
              <div class="pm-ref-arrows">
                <button type="button" data-rail-prev aria-label={text.prev} disabled>‹</button>
                <button type="button" data-rail-next aria-label={text.next}>›</button>
              </div>
            </div>
            <div class="pm-ref-cards" data-rail-track>
              {offerRows.map((o) => (
                <article>
                  <strong>{o.description}</strong>
                  <p>{o.conditions.join(' · ') || text.offerAutomatic}</p>
                  <span class="pm-ref-cards__more">{o.code ? pt(locale, 'offerCode', { code: o.code }) : text.offerAutomatic} ›</span>
                </article>
              ))}
              {STANDING_OFFERS.map((o) => (
                <article>
                  <strong>{o.title}</strong>
                  <p>{o.body}</p>
                  <span class="pm-ref-cards__more">{pt(locale, 'offerCount', { count: 1 })} ›</span>
                </article>
              ))}
              <a href={quoteHref('quotation')}>
                <strong>{text.quoteCta}</strong>
                <p>{text.quoteCardBody}</p>
                <span class="pm-ref-cards__more">{pt(locale, 'offerCount', { count: 1 })} ›</span>
              </a>
              <a href={quoteHref('enquiry')}>
                <strong>{text.enquiryCta}</strong>
                <p>{model.subtitle || model.title}</p>
                <span class="pm-ref-cards__more">{pt(locale, 'offerCount', { count: 1 })} ›</span>
              </a>
            </div>
          </section>

          <section class="pm-ref-services" aria-labelledby="pdp-services-heading">
            <h2 id="pdp-services-heading">{text.serviceInfo}</h2>
            <ul class="pm-ref-service-grid">
              {SERVICES.map((s) => (
                <li class="pm-ref-service">
                  <span class="pm-ref-service__dot"><Icon name={s.icon} /></span>
                  <span>{s.label}</span>
                </li>
              ))}
            </ul>
            <div class="pm-ref-links">
              <a href="#pdp-delivery">{text.deliveryRules}</a>
              <a href="#pdp-details">{text.specifications}</a>
              <a href={quoteHref('quotation')}>{text.quoteCta}</a>
            </div>
          </section>
        </PdpBuyBox>

        <div class="pm-ref-extras">
          <SaveButton productId={model.id} title={model.title} locale={locale} />
          <a class="pm-pdp__store" href={quoteHref('enquiry')}>{text.askAbout}</a>
          <PdpAlerts locale={locale} productId={model.id} title={model.title} variantIds={model.variants.map((v) => v.id)} liveUrl={liveUrl} />
        </div>

        {offerRows.length > 0 && (
          <section class="pm-offers" aria-labelledby="pdp-offers">
            <h2 id="pdp-offers">{text.offers}</h2>
            <ul>
              {offerRows.map((o) => (
                <li class="pm-offer">
                  <strong>{o.description}</strong>
                  {' '}<span>{o.code ? pt(locale, 'offerCode', { code: o.code }) : text.offerAutomatic}</span>
                  {o.conditions.length > 0 && (
                    <ul class="pm-offer__conditions" aria-label={text.offerConditions}>
                      {o.conditions.map((c) => <li>{c}</li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {ruleLines.length > 0 && (
          <section class="pm-delivery-rules" aria-labelledby="pdp-delivery-rules">
            <h2 id="pdp-delivery-rules">{text.deliveryRules}</h2>
            <ul>{ruleLines.map((l) => <li>{l}</li>)}</ul>
          </section>
        )}

        <ExperimentSlot component="trust_strip" showTo={slots.showTo.trust_strip}><TrustStrip locale={locale} labels={socialLabels(locale)} evidence={trust} switchOn={on('trust_strip')} /></ExperimentSlot>
      </div>
    </div>

    {highlights.length > 0 && (
      <section class="pm-highlights" aria-labelledby="pdp-highlights">
        <h2 id="pdp-highlights">{text.highlights}</h2>
        <ul>{highlights.map((h) => <li>{h}</li>)}</ul>
      </section>
    )}

    <nav class="pm-detail-links" aria-label={text.details}>
      {descriptionHtml && <a href="#pdp-description">{text.description}</a>}
      {specs.length > 0 && <a href="#pdp-specifications">{text.specifications}</a>}
      <a href="#pdp-variants">{text.purchaseOptions}</a>
      {storyPhotos.length > 0 && <a href="#pdp-story">{text.details}</a>}
    </nav>
    {storyPhotos.length > 0 && <section class="pm-story" id="pdp-story" aria-label={text.details}>
      {storyPhotos.map((a, index) => <img src={String(a.value)} alt={pt(locale, 'showImage', {index: index + 1}) + ' · ' + model.title} loading="lazy" decoding="async" />)}
    </section>}
    <section class="pm-blocks" aria-labelledby="pdp-details" data-blocks>
      <h2 id="pdp-details" class="pm-visually-hidden">{text.details}</h2>
      {blockList.map((key) => {
        if (key === 'description') {
          return pdpBlockShows(pdpBlocks, 'description', !!descriptionHtml) && (
            <details class="pm-block" id="pdp-description" open data-block="description">
              <summary>{text.description}</summary>
              <div class="pm-block__body" set:html={descriptionHtml} />
            </details>
          );
        }
        if (key === 'specifications') {
          return pdpBlockShows(pdpBlocks, 'specifications', specs.length > 0) && (
            <details class="pm-block" id="pdp-specifications" data-block="specifications">
              <summary>{text.specifications}</summary>
              <dl class="pm-block__body pm-specs">
                {specs.map((s) => <div><dt>{rowLabel(s.key)}</dt><dd>{s.value}</dd></div>)}
              </dl>
            </details>
          );
        }
        const view = presetBlocks.get(key);
        if (!view) return null;
        return (
          <details class="pm-block" open={view.kind === 'quote'} data-block={key}>
            <summary>{blockTitle(key)}</summary>
            {view.kind === 'rows' && (
              <dl class="pm-block__body pm-specs">
                {view.rows.map((r) => <div><dt>{rowLabel(r.key)}</dt><dd>{rowValue(r)}</dd></div>)}
              </dl>
            )}
            {view.kind === 'tiers' && (
              <div class="pm-block__body">
                {view.tiers.length > 0 && (
                  <table class="pm-table pm-tiers">
                    <thead><tr><th scope="col">{text.tierQuantity}</th><th scope="col">{text.tierPrice}</th></tr></thead>
                    <tbody>
                      {view.tiers.map((t) => <tr><td>{pt(locale, 'tierFrom', { qty: t.minQuantity })}</td><td>{formatMoney(t.amount, currency, locale)}</td></tr>)}
                    </tbody>
                  </table>
                )}
                {view.rows.length > 0 && (
                  <dl class="pm-specs">
                    {view.rows.map((r) => <div><dt>{rowLabel(r.key)}</dt><dd>{rowValue(r)}</dd></div>)}
                  </dl>
                )}
              </div>
            )}
            {view.kind === 'compare' && (
              <div class="pm-block__body pm-compare">
                <table class="pm-table">
                  <thead>
                    <tr>
                      <th scope="col">{text.compareAttribute}</th>
                      {view.head.map((h, i) => <th scope="col">{i === 0 ? pt(locale, 'compareThis', { title: h }) : h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {view.rows.map((r) => <tr><th scope="row">{rowLabel(r.key)}</th>{r.values.map((v) => <td>{v || '—'}</td>)}</tr>)}
                  </tbody>
                </table>
              </div>
            )}
            {view.kind === 'quote' && (
              <div class="pm-block__body">
                <p>{text.quoteBody}</p>
                <p class="pm-block__actions">
                  <a class="pm-button pm-button--primary" href={quoteHref('quotation')} data-quotation-request>{text.quoteCta}</a>{' '}
                  <a class="pm-button pm-button--secondary" href={quoteHref('enquiry')} data-enquiry-request>{text.enquiryCta}</a>
                </p>
              </div>
            )}
          </details>
        );
      })}
    </section>

    <Declarations locale={locale} product={declarationProduct} variantId={soleVariantId} />
    <PdpSummary locale={locale} settings={settings} />

    {reviews.enabled && reviewList.length > 0 && (
      <section class="pm-reviews" aria-labelledby="pdp-reviews" data-reviews>
        <h2 id="pdp-reviews">{text.reviews}</h2>
        {reviewSummaryEvidence && <p>{pt(locale, 'reviewsCount', { count: reviewSummaryEvidence.count })}</p>}
        <ExperimentSlot component="review_highlights" showTo={slots.showTo.review_highlights}><ReviewHighlights labels={socialLabels(locale)} evidence={reviews.reviews} switchOn={on('review_highlights')} /></ExperimentSlot>
        <ul class="pm-reviews__dist" aria-label={text.distribution}>
          {dist.map((d) => <li>{pt(locale, 'starsRow', { stars: d.stars, count: d.count })}</li>)}
        </ul>
        <div class="pm-reviews__controls">
          <label for="pdp-review-sort">{text.sortBy}</label>
          <select class="pm-input" id="pdp-review-sort" data-review-sort>
            <option value="newest">{text.sortNewest}</option>
            <option value="highest">{text.sortHighest}</option>
            <option value="lowest">{text.sortLowest}</option>
          </select>
          <label for="pdp-review-filter">{text.filterBy}</label>
          <select class="pm-input" id="pdp-review-filter" data-review-filter>
            <option value="">{text.allRatings}</option>
            {[5, 4, 3, 2, 1].map((s) => <option value={String(s)}>{pt(locale, 'starsOption', { stars: s })}</option>)}
          </select>
        </div>
        <ul class="pm-reviews__list" data-review-list>
          {reviewList.map((r) => (
            <li class="pm-review" data-rating={Math.round(r.rating)} data-time={Date.parse(r.createdAt) || 0}>
              <p class="pm-review__head"><span aria-hidden="true">{'★'.repeat(Math.round(r.rating))}</span><span class="pm-visually-hidden">{pt(locale, 'starsOption', { stars: Math.round(r.rating) })}</span>{r.title && <strong> {r.title}</strong>}</p>
              <p>{r.body}</p>
              <p class="pm-review__meta">{r.author && <span>{pt(locale, 'reviewBy', { name: r.author })}</span>}{r.verified && <span class="pm-badge">{text.verified}</span>}</p>
            </li>
          ))}
        </ul>
        <p data-review-empty hidden>{text.noMatch}</p>
      </section>
    )}

    <PdpRequests locale={locale} productId={model.id} variants={model.variants.map((v) => ({ id: v.id, title: v.title || model.title }))} />

    {showPaired && (
      <ExperimentSlot component="goes_well_with" showTo={slots.showTo.goes_well_with}>
      <PdpGoesWell client:visible locale={locale} labels={journeyLabels(locale)} currency={currency} self={model.id} paired={pairedProducts} errorText={text.addError} />
      </ExperimentSlot>
    )}
    {related.length >= 2 && (
      <section class="pm-rail" aria-labelledby="pdp-rail">
        <h2 id="pdp-rail">{text.railTitle}</h2>
        <ul class="pm-grid pm-rail__grid">
          {related.map((c) => <ProductCard card={c} locale={locale} labels={labels} />)}
        </ul>
      </section>
    )}
  </div>
</Container>

<dialog class="pm-zoom" id="pdp-zoom" aria-label={text.open} data-zoom>
  <div class="pm-zoom__bar">
    <button type="button" class="pm-button pm-button--secondary" data-zoom-out aria-label={text.zoomOut}>−</button>
    <button type="button" class="pm-button pm-button--secondary" data-zoom-in aria-label={text.zoomIn}>+</button>
    <button type="button" class="pm-button pm-button--primary" data-zoom-close>{text.close}</button>
  </div>
  <div class="pm-zoom__stage" data-zoom-stage tabindex="0"><img class="pm-zoom__img" data-zoom-img alt="" src="data:," /></div>
</dialog>

<script>
  import '../../scripts/pdp';
</script>
