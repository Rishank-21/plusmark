---
// The shared parts of a request form: the Turnstile box and the submit button.
import { rq } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; submit: string }
const { locale, submit } = Astro.props;
---
<div class="pm-request__captcha" data-pm-captcha></div>
<button type="submit" class="pm-button pm-button--primary" data-pm-submit data-sending={rq(locale, 'sending')}>{submit}</button>
