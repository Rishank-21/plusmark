---
// One-time Hindi offer on English pages (Req 5.5). Hidden until the script decides to show it; fixed, so no layout shift.
import { t } from '../../lib/i18n';
import { alternatePath } from '../../lib/shell-nav';
interface Props { pathname: string }
const { pathname } = Astro.props;
---
<div class="pm-hindi-prompt" data-pm-hindi-prompt role="region" aria-label={t('en', 'language.switchLabel')} hidden>
  <p class="pm-hindi-prompt__text">{t('en', 'language.prompt.message')}</p>
  <a class="pm-hindi-prompt__accept" href={alternatePath('en', pathname)} hreflang="hi" lang="hi" data-pm-lang-switch>{t('en', 'language.prompt.accept')}</a>
  <button type="button" class="pm-hindi-prompt__close" data-pm-hindi-prompt-close aria-label={t('en', 'language.prompt.close')}>&times;</button>
</div>
<style is:global>
  .pm-hindi-prompt {
    position: fixed;
    inset-inline: 0;
    inset-block-end: calc(var(--pm-bottom-nav-height, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--pm-space-3, 12px);
    padding: var(--pm-space-2, 8px) var(--pm-space-4, 16px);
    background: var(--pm-surface, #fff);
    color: var(--pm-text, #111);
    border-block-start: 1px solid var(--pm-border, #ccc);
  }
  .pm-hindi-prompt[hidden] { display: none; }
  .pm-hindi-prompt__text { margin: 0; flex: 1; }
  .pm-hindi-prompt__accept { min-block-size: 44px; display: inline-flex; align-items: center; font-weight: 600; }
  .pm-hindi-prompt__close { min-inline-size: 44px; min-block-size: 44px; background: none; border: 0; font-size: 1.5rem; color: inherit; cursor: pointer; }
</style>
