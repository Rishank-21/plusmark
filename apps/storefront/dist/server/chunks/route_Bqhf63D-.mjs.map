---
// Internal `/_ondemand/<path>` route (design KD-5, Req 1.9): renders a product, category or collection page that has no
// Static_Page, with the same components as the build. The Storefront_Worker reaches it only after `api.store_resolve_path`
// answered "published"; outside requests for `/_ondemand/` never get here, because the router answers them with 404.
// Injected by the integration in astro.config.mjs, because Astro skips directories that start with an underscore.
import { env } from 'cloudflare:workers';
import ProductPage from '../components/pdp/ProductPage.astro';
import PlpRoute from '../components/plp/PlpRoute.astro';
import { loadPdpData } from '../lib/pdp-data';
import { categoryPath, parseCategories } from '../lib/pdp';
import { categoryIdsBelow } from '../lib/plp-build';
import { loadListing, loadProduct, loadTaxonomy, parseOnDemandPath, type OnDemandEnv } from '../lib/ondemand-data';

export const prerender = false;

const parsed = parseOnDemandPath(String(Astro.params.rest ?? ''));
const bindings = env as unknown as OnDemandEnv;
const e = {
  SUPABASE_URL: bindings.SUPABASE_URL || import.meta.env.PUBLIC_SUPABASE_URL,
  SUPABASE_ANON_KEY: bindings.SUPABASE_ANON_KEY || import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
};
const build = loadPdpData();
const scope = { regionId: build.regionId, currency: build.currency };
let missing = !parsed;
let page: { kind: 'product'; record: Record<string, unknown>; categories: unknown }
  | { kind: 'category' | 'collection'; id: string; categories: unknown; collections: unknown; listing: Awaited<ReturnType<typeof loadListing>> }
  | null = null;
if (parsed) {
  try {
    if (parsed.kind === 'product') {
      const [record, categories] = await Promise.all([loadProduct(e, parsed.segments[0] as string, scope), loadTaxonomy(e, 'categories')]);
      if (record) page = { kind: 'product', record, categories };
    } else {
      const [categories, collections] = await Promise.all([loadTaxonomy(e, 'categories'), loadTaxonomy(e, 'collections')]);
      let id: string | undefined;
      if (parsed.kind === 'category') {
        const rows = parseCategories(categories);
        id = rows.find((c) => categoryPath(rows, c.id) === parsed.segments.join('/'))?.id;
        if (id) {
          const listing = await loadListing(e, scope, { categoryIds: [...categoryIdsBelow(rows, id)] });
          page = { kind: 'category', id, categories, collections, listing };
        }
      } else {
        const list = (collections as { collections?: { id?: string; handle?: string }[] }).collections ?? [];
        id = list.find((c) => c.handle === parsed.segments[0])?.id;
        if (id) page = { kind: 'collection', id, categories, collections, listing: await loadListing(e, scope, { collectionId: id }) };
      }
    }
  } catch {
    return new Response('Service unavailable', { status: 503, headers: { 'Cache-Control': 'no-store', 'Retry-After': '30' } });
  }
  missing = page === null;
}
if (missing || !parsed || !page) return new Response(null, { status: 404 });
---
{page.kind === 'product' && (
  <ProductPage locale={parsed.locale} handle={parsed.segments[0] as string} record={page.record} categoriesData={page.categories} />
)}
{page.kind === 'category' && (
  <PlpRoute locale={parsed.locale} categoryId={page.id} onDemand={{ categories: page.categories, collections: page.collections, listing: page.listing }} />
)}
{page.kind === 'collection' && (
  <PlpRoute locale={parsed.locale} collectionId={page.id} onDemand={{ categories: page.categories, collections: page.collections, listing: page.listing }} />
)}
