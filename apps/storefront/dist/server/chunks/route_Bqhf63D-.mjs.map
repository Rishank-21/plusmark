---
// Under the Buy_Box: the save control and the Back_In_Stock_Alert (Req 15.4, 11.16).
import SaveButton from './SaveButton.astro';
import BackInStockForm from './BackInStockForm.astro';
import { buildFeatures } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; productId: string; title: string; variantIds: string[]; liveUrl: string | null }
const { locale, productId, title, variantIds, liveUrl } = Astro.props;
const features = buildFeatures();
---
<div class="pm-pdp__extras">
  <SaveButton productId={productId} title={title} locale={locale} />
</div>
{features.backInStock && variantIds.length > 0 && <BackInStockForm locale={locale} productId={productId} variantIds={variantIds} liveUrl={liveUrl} />}
