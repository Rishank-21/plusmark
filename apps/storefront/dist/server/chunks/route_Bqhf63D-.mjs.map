---
// A category (`/shop/<path>`) or collection (`/collections/<handle>`) page: layout plus the PLP, from the build's catalog data.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlpPage from './PlpPage.astro';
import { loadPdpData } from '../../lib/pdp-data';
import { loadShellData } from '../../lib/shell-data';
import { categoryChain, categoryPath, parseCategories } from '../../lib/pdp';
import { categoryIdsBelow, listingOf, productsIn } from '../../lib/plp-build';
import { localizePath } from '../../lib/shell-nav';
import { t, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, metaDescription } from '../../lib/seo';
import { hiddenFilterGroups, resolveLayout } from '../../lib/presets';
import categoriesJson from '../../data/categories.json';
import collectionsJson from '../../data/collections.json';

interface Props {
  locale: Locale;
  categoryId?: string;
  collectionId?: string;
  /** An On_Demand_Page passes what it read from the Store_API (design KD-5); a Static_Page reads the build data. */
  onDemand?: { categories: unknown; collections: unknown; listing: ReturnType<typeof listingOf> };
}
const { locale, categoryId, collectionId, onDemand } = Astro.props;
const data = loadPdpData();
const categoriesSource = (onDemand?.categories ?? categoriesJson) as { categories?: Record<string, unknown>[] };
const collectionsSource = (onDemand?.collections ?? collectionsJson) as { collections?: Record<string, unknown>[] };
const rows = parseCategories(categoriesSource);
const raw = (categoryId ? categoriesSource.categories : collectionsSource.collections) ?? [];
const record = raw.find((r) => r.id === (categoryId ?? collectionId));
const shell = loadShellData();
const allProducts = !categoryId && !collectionId;
const title = allProducts ? t(locale, 'nav.shopAll') : String((categoryId ? record?.name : record?.title) ?? '');
const listing = onDemand?.listing ?? listingOf(productsIn(data.products, categoryId ? { categoryIds: categoryIdsBelow(rows, categoryId) } : { collectionId }));
const layout = resolveLayout(data.settings);
const hidden = [...new Set([...(categoryId ? ['categories'] : collectionId ? ['collections'] : []), ...hiddenFilterGroups(layout.plpFilters)])];
const crumbs = [
  { label: t(locale, 'plp.home'), href: localizePath(locale, '/') },
  ...(categoryId ? categoryChain(rows, categoryId).map((c) => ({ label: c.name, href: localizePath(locale, `/shop/${categoryPath(rows, c.id)}`) })) : [{ label: title, href: '' }]),
];
const path = localizePath(locale, allProducts ? '/shop' : categoryId ? `/shop/${categoryPath(rows, categoryId)}` : `/collections/${String(record?.handle ?? '')}`);
const pageUrl = Astro.site ? new URL(path, Astro.site).href : path;
const site = Astro.site ? String(Astro.site) : '';
const description = metaDescription(typeof record?.description === 'string' ? record.description : '', `${title} | ${shell.brand.name}`);
---
<BaseLayout title={`${title} | ${shell.brand.name}`} description={description} locale={locale} path={path} shell={shell} jsonLd={[breadcrumbJsonLd(crumbs, pageUrl, site)]}>
  <PlpPage
    locale={locale}
    title={title}
    items={listing.items}
    total={listing.total}
    facets={listing.facets}
    scope={{ categoryId: categoryId ?? null, collectionId: collectionId ?? null, regionId: data.regionId, currency: data.currency.toLowerCase() }}
    description={typeof record?.description === 'string' ? record.description : null}
    breadcrumbs={crumbs}
    badgePriority={layout.badgePriority}
    freeDeliveryThreshold={typeof data.rules.free_delivery_threshold === 'number' ? data.rules.free_delivery_threshold : null}
    hideFilters={hidden}
  />
</BaseLayout>
