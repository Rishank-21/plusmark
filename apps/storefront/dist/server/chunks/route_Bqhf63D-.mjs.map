---
// PLP (Req 8): the first 24 products of the default listing are built into the page. The island (scripts/plp.ts) answers
// filters, sort orders and load-more with GET calls to `store_list_products` and keeps state in the URL (Req 8.8).
import '../../styles/plp.css';
import Container from '../ui/Container.astro';
import Dialog from '../ui/Dialog.astro';
import Button from '../ui/Button.astro';
import ProductCard from './ProductCard.astro';
import FilterForm from './FilterForm.astro';
import { t, type Locale } from '../../lib/i18n';
import { sanitizeHtml } from '../../lib/sanitize';
import { localizePath } from '../../lib/shell-nav';
import { cardOf } from '../../lib/plp-card';
import { cardLabels, plpUiLabels } from '../../lib/plp-labels';
import { emptyState, PAGE_SIZE, SORTS, type PlpScope } from '../../lib/plp-state';
import type { ImageSource } from '../../lib/images';

interface Props {
  locale: Locale;
  title: string;
  /** `items`, `total` and `facets` of the build's `store_list_products` call (first 24, default order). */
  items: unknown[];
  total: number;
  facets: Record<string, unknown>;
  scope: PlpScope;
  /** Category or collection description, shown below the grid (Req 8.11). Sanitised here. */
  description?: string | null;
  breadcrumbs?: { label: string; href: string }[];
  /** Badge keys in the Business_Preset's priority order. */
  badgePriority: string[];
  freeDeliveryThreshold?: number | null;
  bestSellerIds?: string[];
  /** Processed images by Medusa image ID. */
  images?: Record<string, ImageSource>;
  hideFilters?: string[];
  /** Search text for a results PLP. */
  query?: string;
  /** Search results page: the empty state comes from the "empty" slot and stays hidden until the island has loaded. */
  deferEmpty?: boolean;
}
const {
  locale, title, items, total, facets, scope, description, breadcrumbs = [], badgePriority, freeDeliveryThreshold = null,
  bestSellerIds = [], images = {}, hideFilters = [], query = '', deferEmpty = false,
} = Astro.props;
const state = emptyState(query);
const labels = cardLabels(locale);
const ui = plpUiLabels(locale);
const best = new Set(bestSellerIds);
const cards = items.map((p) => cardOf(p, { badgePriority, now: Date.now(), freeDeliveryThreshold, bestSellerIds: best })).filter((c) => c !== null);
const sortLabel = (s: string) => t(locale, `plp.sort${s === 'price_asc' ? 'PriceAsc' : s === 'price_desc' ? 'PriceDesc' : s === 'title_asc' ? 'TitleAsc' : s[0].toUpperCase() + s.slice(1)}`);
const sorts = SORTS.filter((s) => s !== 'relevance' || query || deferEmpty);
const config = {
  locale, scope, badgePriority, freeDeliveryThreshold, bestSellerIds, hideFilters, query,
  labels, ui, total, pageSize: PAGE_SIZE,
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c').replace(/\u2028|\u2029/g, '');
const rankingHref = localizePath(locale, '/ranking-disclosure');
const remaining = Math.min(PAGE_SIZE, Math.max(0, total - cards.length));
---
<Container>
  <div class="pm-plp" data-plp>
    {breadcrumbs.length > 0 && (
      <nav aria-label={t(locale, 'plp.breadcrumbs')} class="pm-breadcrumbs">
        <ol>
          {breadcrumbs.map((b, i) => (
            <li>{i < breadcrumbs.length - 1 ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <header class="pm-plp__head">
      <h1 data-plp-title>{title}</h1>
      <p class="pm-plp__count" data-plp-count>{t(locale, total === 1 ? 'plp.productCount.one' : 'plp.productCount.other', { count: total })}</p>
    </header>

    <div class="pm-plp__bar" data-plp-bar>
      <button type="button" class="pm-button pm-button--secondary pm-plp__filter-button" data-pm-open="plp-filters" data-plp-filter-button>
        <span data-plp-filter-label>{t(locale, 'plp.filters')}</span>
      </button>
      <div class="pm-plp__sort">
        <label class="pm-label" for="plp-sort">{t(locale, 'plp.sort')}</label>
        <select class="pm-input" id="plp-sort" data-plp-sort>
          {sorts.map((s) => <option value={s} selected={s === state.sort}>{sortLabel(s)}</option>)}
        </select>
        <a class="pm-link" href={rankingHref}>{t(locale, 'plp.rankingLink')}</a>
      </div>
    </div>

    <div class="pm-plp__chips" data-plp-chips hidden>
      <ul aria-label={t(locale, 'plp.appliedFilters')} data-plp-chip-list></ul>
      <button type="button" class="pm-button pm-button--ghost" data-plp-clear>{t(locale, 'plp.clearAll')}</button>
    </div>

    <div class="pm-plp__body">
      <aside class="pm-plp__column" aria-label={t(locale, 'plp.filters')}>
        <FilterForm idPrefix="plp-col" locale={locale} facets={facets} state={state} hide={hideFilters} />
      </aside>
      <div class="pm-plp__results">
        <ul class="pm-grid pm-plp__grid" data-plp-grid>
          {cards.map((c, i) => <ProductCard card={c} locale={locale} labels={labels} image={c.imageId ? images[c.imageId] : undefined} priority={i === 0} />)}
        </ul>
        <div class="pm-plp__empty" data-plp-empty hidden={total > 0 || deferEmpty || undefined}>
          {Astro.slots.has('empty') ? <slot name="empty" /> : (
            <>
              <p><strong>{t(locale, 'plp.empty')}</strong></p>
              <p>{t(locale, 'plp.emptyHint')}</p>
            </>
          )}
          <Button variant="secondary" data-plp-clear>{t(locale, 'plp.clearAll')}</Button>
        </div>
        <div class="pm-plp__more" data-plp-more hidden={remaining === 0 || undefined}>
          <p data-plp-status>{t(locale, 'plp.showing', { shown: cards.length, total })}</p>
          <Button variant="secondary" data-plp-load-more>{t(locale, 'plp.loadMore', { count: remaining })}</Button>
        </div>
        <p class="pm-error" role="alert" data-plp-error hidden>
          {t(locale, 'plp.error')} <button type="button" class="pm-link" data-plp-retry>{t(locale, 'plp.retry')}</button>
        </p>
      </div>
    </div>

    {description && <section class="pm-plp__description" set:html={sanitizeHtml(description)} />}
  </div>
</Container>

<Dialog id="plp-filters" title={t(locale, 'plp.filters')} closeLabel={t(locale, 'plp.closeFilters')} variant="sheet">
  <FilterForm idPrefix="plp-sheet" locale={locale} facets={facets} state={state} hide={hideFilters} />
  <div class="pm-plp__apply">
    <Button block data-plp-apply>{t(locale, 'plp.showResults.other', { count: total })}</Button>
  </div>
</Dialog>

<script type="application/json" id="plp-config" set:html={configJson}></script>
<script>
  import '../../scripts/plp';
</script>
