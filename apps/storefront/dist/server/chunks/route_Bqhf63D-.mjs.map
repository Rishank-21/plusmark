---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  block?: boolean;
  disabled?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'primary', type = 'button', href, block = false, disabled = false, class: cls = '', ...rest } = Astro.props;
const classes = ['pm-button', variant !== 'primary' && `pm-button--${variant}`, block && 'pm-button--block', cls].filter(Boolean).join(' ');
---
{href && !disabled
  ? <a href={href} class={classes} {...rest}><slot /></a>
  : <button type={type} class={classes} disabled={disabled} {...rest}><slot /></button>}
