---
// Below the reviews: the review form, the Enquiry form and the Quotation request, each only while its Optional_Feature is on (Req 15.6).
import ReviewForm from './ReviewForm.astro';
import EnquiryForm from './EnquiryForm.astro';
import QuotationForm from './QuotationForm.astro';
import { buildFeatures } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; productId: string; variants: { id: string; title: string }[] }
const { locale, productId, variants } = Astro.props;
const f = buildFeatures();
---
{f.reviews && <ReviewForm locale={locale} productId={productId} />}
{f.enquiries && <EnquiryForm locale={locale} productId={productId} replyHours={f.replyHours} />}
{f.quotations && variants.length > 0 && <QuotationForm locale={locale} variants={variants} replyHours={f.replyHours} />}
