---
import '../../styles/legal.css';
// PDP: short return, warranty and delivery summary with links to the full policies (Req 16.3).
import { t, type Locale } from '../../lib/i18n';
import { localizePath } from '../../lib/shell-nav';
import { pdpSummary } from '../../lib/legal';

interface Props { locale: Locale; settings: Record<string, unknown> }
const { locale, settings } = Astro.props;
const items = pdpSummary(settings, locale);
---
<section class="pm-pdp-legal" aria-labelledby="pm-pdp-summary">
  <h2 id="pm-pdp-summary" class="pm-pdp-legal__heading">{t(locale, 'legal.pdp.summaryHeading')}</h2>
  <ul class="pm-pdp-legal__list">
    {items.map((i) => (
      <li>
        <strong>{t(locale, `legal.pdp.${i.kind}`)}:</strong>
        {' '}{i.text || t(locale, 'legal.pdp.noSummary')}
        {' '}<a class="pm-link" href={localizePath(locale, `/policies/${i.policy}`)}>{t(locale, 'legal.pdp.readMore')}</a>
      </li>
    ))}
  </ul>
</section>
