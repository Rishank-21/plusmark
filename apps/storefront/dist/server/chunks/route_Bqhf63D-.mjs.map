---
// Native <dialog>: focus trap and Escape come from the browser. variant="sheet" docks it to the bottom (phone) or side.
interface Props { id: string; title: string; closeLabel: string; variant?: 'dialog' | 'sheet' }
const { id, title, closeLabel, variant = 'dialog' } = Astro.props;
---
<dialog id={id} class={`pm-dialog ${variant === 'sheet' ? 'pm-dialog--sheet' : ''}`.trim()} aria-labelledby={`${id}-title`} data-pm-dialog>
  <div class="pm-dialog__header">
    <h2 id={`${id}-title`}>{title}</h2>
    <button type="button" class="pm-button pm-button--ghost" data-pm-close aria-label={closeLabel}>
      <svg class="pm-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <slot />
</dialog>
