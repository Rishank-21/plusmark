---
// Newsletter sign-up (Req 21.4): the address gets a confirmation link before any consent is recorded.
import RequestSection from './RequestSection.astro';
import FormEnd from './FormEnd.astro';
import { rq } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; heading?: string; intro?: string; hideHeading?: boolean }
const { locale, heading, intro, hideHeading = false } = Astro.props;
const id = 'pm-news';
---
<RequestSection locale={locale} id={id} heading={hideHeading ? undefined : heading ?? rq(locale, 'news.heading')} intro={hideHeading ? undefined : intro ?? rq(locale, 'news.text')}>
  <form class="pm-request__form" data-pm-form data-action="newsletter_signup" novalidate>
    <div class="pm-field"><label class="pm-label" for={`${id}-email`}>{rq(locale, 'news.email')}</label>
      <input class="pm-input" id={`${id}-email`} name="email" type="email" inputmode="email" maxlength="254" autocomplete="email" required /></div>
    <FormEnd locale={locale} submit={rq(locale, 'news.submit')} />
  </form>
  <div class="pm-request__done" data-pm-done hidden></div>
</RequestSection>
