---
// The filter fields. Rendered twice by PlpPage: in the sheet (below 1,024 px) and in the column (from 1,024 px).
// Checked boxes are the applied filters read from the URL, which is why this does not use the Checkbox primitive.
import { t, type Locale } from '../../lib/i18n';
import type { PlpState } from '../../lib/plp-state';

interface Props {
  idPrefix: string;
  locale: Locale;
  facets: Record<string, unknown>;
  state: PlpState;
  /** Facet groups to leave out (for example `categories` on a category page with no subcategories). */
  hide?: string[];
}
const { idPrefix, locale, facets, state, hide = [] } = Astro.props;
type Row = { id: string; label: string; count: number };
const arr = (k: string): Record<string, unknown>[] => (Array.isArray(facets[k]) ? (facets[k] as Record<string, unknown>[]) : []);
const rows = (k: string, labelKey: string): Row[] =>
  arr(k).map((f) => ({ id: String(f.id), label: String(f[labelKey] ?? ''), count: Number(f.count) || 0 })).filter((r) => r.id && r.label);
const groups = [
  { key: 'categories', name: 'cat', title: t(locale, 'plp.categories'), rows: rows('categories', 'name'), on: state.categories },
  { key: 'collections', name: 'col', title: t(locale, 'plp.collections'), rows: rows('collections', 'title'), on: state.collections },
  { key: 'types', name: 'type', title: t(locale, 'plp.types'), rows: rows('types', 'value'), on: state.types },
  { key: 'tags', name: 'tag', title: t(locale, 'plp.tags'), rows: rows('tags', 'value'), on: state.tags },
].filter((g) => g.rows.length > 0 && !hide.includes(g.key));
const options = arr('options')
  .map((o) => ({ name: String(o.name), values: (Array.isArray(o.values) ? o.values : []) as { value: string; count: number }[] }))
  .filter((o) => o.name && o.values.length > 0 && !hide.includes('options'));
const price = (facets.price ?? {}) as { min?: number | null; max?: number | null };
const showPrice = !hide.includes('price') && price.min != null && price.max != null && price.max > price.min;
---
<form class="pm-filters" data-plp-form method="get" action="" id={`${idPrefix}-form`}>
  {groups.map((g) => (
    <fieldset class="pm-filters__group">
      <legend>{g.title}</legend>
      <ul>
        {g.rows.map((r, i) => (
          <li class="pm-checkbox">
            <input type="checkbox" id={`${idPrefix}-${g.name}-${i}`} name={g.name} value={r.id} checked={g.on.includes(r.id)} data-label={r.label} />
            <label for={`${idPrefix}-${g.name}-${i}`}>{r.label} <span class="pm-filters__count">({r.count})</span></label>
          </li>
        ))}
      </ul>
    </fieldset>
  ))}
  {options.map((o, n) => (
    <fieldset class="pm-filters__group">
      <legend>{o.name}</legend>
      <ul>
        {o.values.map((v, i) => (
          <li class="pm-checkbox">
            <input type="checkbox" id={`${idPrefix}-o${n}-${i}`} name={`o.${o.name}`} value={v.value} checked={(state.options[o.name] ?? []).includes(v.value)} data-label={`${o.name}: ${v.value}`} />
            <label for={`${idPrefix}-o${n}-${i}`}>{v.value} <span class="pm-filters__count">({v.count})</span></label>
          </li>
        ))}
      </ul>
    </fieldset>
  ))}
  {showPrice && (
    <fieldset class="pm-filters__group pm-filters__price">
      <legend>{t(locale, 'plp.price')}</legend>
      <div class="pm-field">
        <label class="pm-label" for={`${idPrefix}-min`}>{t(locale, 'plp.priceMin')}</label>
        <input class="pm-input" type="number" inputmode="decimal" min="0" step="any" id={`${idPrefix}-min`} name="min" value={state.priceMin ?? ''} placeholder={String(price.min)} />
      </div>
      <div class="pm-field">
        <label class="pm-label" for={`${idPrefix}-max`}>{t(locale, 'plp.priceMax')}</label>
        <input class="pm-input" type="number" inputmode="decimal" min="0" step="any" id={`${idPrefix}-max`} name="max" value={state.priceMax ?? ''} placeholder={String(price.max)} />
      </div>
    </fieldset>
  )}
</form>
