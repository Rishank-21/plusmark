---
// Header: logo and name, search entry, menu (categories and language), Cart count island and account link (Req 7.1, 5.3).
import Icon from '../ui/Icon.astro';
import Dialog from '../ui/Dialog.astro';
import VisuallyHidden from '../ui/VisuallyHidden.astro';
import CartCount from './CartCount';
import { t, type Locale } from '../../lib/i18n';
import { alternatePath, currentNav, localizePath, otherLocale } from '../../lib/shell-nav';
import type { ShellData } from '../../lib/shell-data';
import '../../styles/search.css';
import { loadPdpData } from '../../lib/pdp-data';
import { parseCategories } from '../../lib/pdp';
import { menuTree } from '../../lib/search';
import { cardLabels } from '../../lib/plp-labels';
import categoriesJson from '../../data/categories.json';

interface Props { locale: Locale; pathname: string; shell: ShellData }
const { locale, pathname, shell } = Astro.props;
const current = currentNav(pathname);
const other = otherLocale(locale);
const home = localizePath(locale, '/');
const rows = parseCategories(categoriesJson);
// Without catalog data the menu falls back to the shell's category list.
const menu = rows.length
  ? menuTree(rows)
  : shell.categories.filter((c) => !c.slug.startsWith('demo-')).map((c) => ({ id: c.slug, name: c.name[locale], path: c.slug, children: [] }));
const topNav = menu.slice(0, 6);
const useWordmark = !shell.brand.logoUrl && shell.brand.name.toLowerCase() === 'plusmark';
const pdp = loadPdpData();
const supportPhone = shell.seller.customerCarePhone;
const searchConfig = JSON.stringify({
  locale, regionId: pdp.regionId, currency: pdp.currency.toLowerCase(), categories: rows.map((r) => ({ id: r.id, handle: r.handle, name: r.name, parent: r.parent })),
  searchPath: localizePath(locale, '/search'), shopPrefix: localizePath(locale, '/shop'),
  labels: { ...Object.fromEntries(['suggestions', 'products', 'categories', 'recent', 'clearRecent', 'seeAll', 'loading', 'found', 'none'].map((k) => [k, t(locale, `search.${k}`)])), card: cardLabels(locale) },
}).replace(/</g, '\\u003c').replace(/\u2028|\u2029/g, '');
---
<header class="pm-header" data-pm-header aria-label={t(locale, 'landmarks.header')}>
  <div class="pm-announce">
    <div class="pm-container pm-announce__inner">
      <p>{t(locale, 'nav.announce')}</p>
      <a href={localizePath(locale, '/contact')} class="pm-announce__link">{t(locale, 'nav.bulk')}</a>
    </div>
  </div>
  <div class="pm-container pm-header__inner">
    <button type="button" class="pm-button pm-button--ghost pm-header__menu" data-pm-open="pm-menu" aria-haspopup="dialog">
      <Icon name="menu" />
      <VisuallyHidden>{t(locale, 'nav.menu')}</VisuallyHidden>
    </button>
    <a class="pm-header__brand" href={home} aria-current={current === 'home' ? 'page' : undefined}>
      {shell.brand.logoUrl
        ? <img src={shell.brand.logoUrl} alt="" height="34" class="pm-header__logo" />
        : useWordmark ? <img class="pm-header__wordmark" src="/plusmark-wordmark.png" width="150" height="30" alt="" />
        : <span class="pm-header__mark" aria-hidden="true">{shell.brand.name.charAt(0)}</span>}
      <span class={useWordmark ? 'pm-visually-hidden' : 'pm-header__name'}>{shell.brand.name}</span>
    </a>
    <nav class="pm-header__nav" aria-label={t(locale, 'nav.categoriesTitle')}>
      <ul>
        {topNav.map((c) => c.children.length > 0 ? (
          <li class="pm-nav-item">
            <a href={localizePath(locale, `/shop/${c.path}`)}>{c.name}</a>
            {/* Mega menu (skill: mega-menu-builder): opens on hover and on keyboard focus, no script needed. */}
            <div class="pm-mega">
              <p class="pm-mega__title">{c.name}</p>
              <ul class="pm-mega__links">
                {c.children.slice(0, 10).map((s) => (
                  <li><a href={localizePath(locale, `/shop/${s.path}`)}>{s.name}</a></li>
                ))}
              </ul>
              <a class="pm-mega__all" href={localizePath(locale, `/shop/${c.path}`)}>
                {t(locale, 'search.viewAll', { name: c.name })}
              </a>
            </div>
          </li>
        ) : (
          <li><a href={localizePath(locale, `/shop/${c.path}`)}>{c.name}</a></li>
        ))}
        <li><a class="pm-header__nav-all" href={localizePath(locale, '/shop')}>{t(locale, 'nav.shopAll')}</a></li>
      </ul>
    </nav>
    <form class="pm-header__search" role="search" action={localizePath(locale, '/search')} method="get">
      <label class="pm-visually-hidden" for="pm-search-q">{t(locale, 'nav.searchLabel')}</label>
      <input class="pm-input" id="pm-search-q" name="q" type="search" enterkeyhint="search" autocomplete="off" placeholder={t(locale, 'nav.searchLabel')} role="combobox" aria-expanded="false" aria-controls="pm-suggest" aria-autocomplete="list" />
      <button type="submit" class="pm-header__search-button" aria-label={t(locale, 'nav.searchSubmit')}>
        <Icon name="search" />
      </button>
      <div class="pm-suggest" id="pm-suggest" data-pm-suggest hidden></div>
      <p class="pm-visually-hidden" role="status" aria-live="polite" data-pm-suggest-status></p>
    </form>
    {supportPhone && (
      <a class="pm-header__action pm-header__support" href={`tel:${supportPhone.replace(/[^+\d]/g, '')}`}>
        <Icon name="phone" />
        <span class="pm-header__action-text">{t(locale, 'nav.support')}</span>
      </a>
    )}
    <a class="pm-header__action" href={localizePath(locale, '/account')} aria-current={current === 'account' ? 'page' : undefined}>
      <Icon name="user" />
      <span class="pm-header__action-text">{t(locale, 'nav.account')}</span>
    </a>
    <a class="pm-header__action pm-header__cart" href={localizePath(locale, '/cart')} aria-current={current === 'cart' ? 'page' : undefined}>
      <Icon name="cart" />
      <span class="pm-header__action-text">{t(locale, 'nav.cart')}</span>
      <CartCount client:idle label={t(locale, 'nav.cartItems')} />
    </a>
  </div>
  <Dialog id="pm-menu" title={t(locale, 'nav.menu')} closeLabel={t(locale, 'a11y.close')} variant="sheet">
    <nav aria-label={t(locale, 'nav.categoriesTitle')}>
      <h3>{t(locale, 'nav.categoriesTitle')}</h3>
      <ul class="pm-menu-list">
        {menu.map((c) => (
          <li>
            {c.children.length === 0 ? (
              <a class="pm-menu-link" href={localizePath(locale, `/shop/${c.path}`)}>{c.name}</a>
            ) : (
              <details class="pm-menu-group">
                <summary class="pm-menu-link">{c.name}</summary>
                <ul class="pm-menu-sublist" aria-label={t(locale, 'search.subcategories', { name: c.name })}>
                  <li><a class="pm-menu-link" href={localizePath(locale, `/shop/${c.path}`)}>{t(locale, 'search.viewAll', { name: c.name })}</a></li>
                  {c.children.map((s) => <li><a class="pm-menu-link" href={localizePath(locale, `/shop/${s.path}`)}>{s.name}</a></li>)}
                </ul>
              </details>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="pm-menu-language">
      <h3>{t(locale, 'nav.language')}</h3>
      <a class="pm-menu-link" href={alternatePath(locale, pathname)} hreflang={other} lang={other} data-pm-lang-switch>{t(locale, 'nav.otherLanguageName')}</a>
    </div>
  </Dialog>
  <script type="application/json" id="pm-search-config" set:html={searchConfig}></script>
</header>
