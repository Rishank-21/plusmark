---
// Consent banner (Req 17.1-17.3). Fixed at the bottom, blocks nothing, hidden until the script finds no current choice.
// "Accept all", "Only necessary" and "Choose" share one class list; both switches start off.
import { t, type Locale } from '../../lib/i18n';
import { BUTTON_LOOK } from '../../lib/consent';
interface Props { locale: Locale; pathname: string }
const { locale } = Astro.props;
const cls = BUTTON_LOOK.className;
---
<section class="pm-consent" data-pm-consent role="region" aria-labelledby="pm-consent-title" hidden>
  <h2 id="pm-consent-title" class="pm-consent__title">{t(locale, 'consent.title')}</h2>
  <p class="pm-consent__text">{t(locale, 'consent.text')}</p>
  <div class="pm-consent__choices" data-pm-consent-choices hidden>
    <label class="pm-consent__switch">
      <input type="checkbox" role="switch" data-pm-consent-purpose="analytics" />
      <span><strong>{t(locale, 'consent.analytics')}</strong> {t(locale, 'consent.analyticsText')}</span>
    </label>
    <label class="pm-consent__switch">
      <input type="checkbox" role="switch" data-pm-consent-purpose="marketing_tags" />
      <span><strong>{t(locale, 'consent.marketing')}</strong> {t(locale, 'consent.marketingText')}</span>
    </label>
  </div>
  <div class="pm-consent__actions">
    <button type="button" class={cls} data-pm-consent-accept>{t(locale, 'consent.acceptAll')}</button>
    <button type="button" class={cls} data-pm-consent-necessary>{t(locale, 'consent.onlyNecessary')}</button>
    <button type="button" class={cls} data-pm-consent-choose aria-expanded="false">{t(locale, 'consent.choose')}</button>
    <button type="button" class={cls} data-pm-consent-save hidden>{t(locale, 'consent.save')}</button>
  </div>
</section>
<style is:global>
  .pm-consent {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 50;
    max-block-size: 60vh;
    overflow-y: auto;
    padding: var(--pm-space-4);
    background: var(--pm-card, #fff);
    color: var(--pm-text, #111);
    border-block-start: 1px solid var(--pm-border-subtle, #ddd);
    box-shadow: 0 -12px 32px rgb(23 32 43 / 12%);
  }
  @media (max-width: 767.98px) {
    .pm-consent { inset-block-end: calc(var(--pm-bottomnav-height, 0px) + env(safe-area-inset-bottom, 0px)); }
  }
  @media (min-width: 768px) {
    .pm-consent {
      inset-inline: auto var(--pm-space-6);
      inset-block-end: var(--pm-space-6);
      width: min(30rem, calc(100vw - 3rem));
      border: 1px solid var(--pm-border-subtle);
      border-radius: var(--pm-radius-xl);
    }
  }
  .pm-consent[hidden], .pm-consent [hidden] { display: none; }
  .pm-consent__title { margin: 0 0 var(--pm-space-1, 4px); font-size: 1rem; }
  .pm-consent__text { margin: 0 0 var(--pm-space-3); font-size: var(--pm-text-sm); color: var(--pm-text-muted); }
  .pm-consent__switch { display: flex; align-items: flex-start; gap: var(--pm-space-2, 8px); min-block-size: 44px; margin-block-end: var(--pm-space-2, 8px); }
  .pm-consent__actions { display: flex; flex-wrap: wrap; gap: var(--pm-space-2, 8px); }
  .pm-consent__button { min-block-size: 44px; flex: 1 1 8rem; justify-content: center; }
</style>
