---
import '../../styles/legal.css';
// PDP: the Mandatory_Declarations that apply, with the country of origin and an importer's name and address (Req 16.4).
import { t, type Locale } from '../../lib/i18n';
import { mandatoryDeclarations, type DeclarationProduct } from '../../lib/legal';

interface Props { locale: Locale; product: DeclarationProduct; variantId?: string | null }
const { locale, product, variantId = null } = Astro.props;
const lines = mandatoryDeclarations(product, variantId, locale);
---
{lines.length > 0 && (
  <section class="pm-pdp-legal" aria-labelledby="pm-pdp-declarations">
    <h2 id="pm-pdp-declarations" class="pm-pdp-legal__heading">{t(locale, 'legal.pdp.declarationsHeading')}</h2>
    <dl class="pm-legal__facts">
      {lines.map((l) => <div><dt>{t(locale, `legal.pdp.${l.kind}`)}</dt><dd>{l.value}</dd></div>)}
    </dl>
  </section>
)}
