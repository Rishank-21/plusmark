---
// Quick view (skill: quick-view-modal): one native <dialog> per page, filled from the card's data attributes by
// scripts/quick-view.ts. Focus trapping and Escape come from the browser; the backdrop click is handled by scripts/ui.ts.
import { t, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<dialog id="pm-quick-view" class="pm-quickview" aria-labelledby="pm-quick-view-title" data-pm-dialog>
  <div class="pm-quickview__media">
    <img class="pm-quickview__img" data-quick-view-img alt="" width="640" height="640" hidden />
    <ul class="pm-quickview__badges" data-quick-view-badges hidden></ul>
  </div>
  <div class="pm-quickview__body">
    <div class="pm-quickview__head">
      <h2 id="pm-quick-view-title" tabindex="-1" data-quick-view-title></h2>
      <button type="button" class="pm-button pm-button--ghost pm-quickview__close" data-pm-close aria-label={t(locale, 'plp.close')}>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <p class="pm-quickview__price" data-quick-view-price></p>
    <p class="pm-quickview__prior" data-quick-view-prior hidden></p>
    <div class="pm-quickview__actions" data-quick-view-actions></div>
    <a class="pm-quickview__full" data-quick-view-full href="#">{t(locale, 'plp.viewFull')}</a>
  </div>
</dialog>

<script>
  import '../../scripts/quick-view';
</script>
