---
import RequestSection from './RequestSection.astro';
import FormEnd from './FormEnd.astro';
import { rq } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; variants: { id: string; title: string }[]; replyHours: number; id?: string }
const { locale, variants, replyHours, id = 'pm-quote' } = Astro.props;
const options = variants.length ? variants : [];
---
<RequestSection locale={locale} id={id} heading={rq(locale, 'quote.heading')} intro={rq(locale, 'quote.intro', { hours: replyHours })}>
  <form class="pm-request__form" data-pm-form data-action="request_quotation" data-reply-hours={String(replyHours)} novalidate>
    <div data-pm-lines>
      <div class="pm-request__line" data-pm-line>
        <div class="pm-field"><label class="pm-label" for={`${id}-variant-0`}>{rq(locale, 'quote.variant')}</label>
          <select class="pm-input" id={`${id}-variant-0`} data-line-variant>
            {options.map((v) => <option value={v.id}>{v.title}</option>)}
          </select></div>
        <div class="pm-field"><label class="pm-label" for={`${id}-qty-0`}>{rq(locale, 'quote.quantity')}</label>
          <input class="pm-input" id={`${id}-qty-0`} type="number" min="1" max="9999" value="1" inputmode="numeric" data-line-qty /></div>
        <button type="button" class="pm-link" data-line-remove hidden>{rq(locale, 'quote.removeLine')}</button>
      </div>
    </div>
    <button type="button" class="pm-button pm-button--ghost" data-pm-add-line hidden={options.length < 2}>{rq(locale, 'quote.addLine')}</button>
    <div class="pm-field"><label class="pm-label" for={`${id}-email`}>{rq(locale, 'quote.email')}</label>
      <input class="pm-input" id={`${id}-email`} name="email" type="email" inputmode="email" maxlength="254" autocomplete="email" required /></div>
    <div class="pm-field"><label class="pm-label" for={`${id}-note`}>{rq(locale, 'quote.note')}</label>
      <textarea class="pm-input" id={`${id}-note`} name="note" rows="3" maxlength="2000"></textarea></div>
    <FormEnd locale={locale} submit={rq(locale, 'quote.submit')} />
  </form>
  <div class="pm-request__done" data-pm-done hidden></div>
</RequestSection>
