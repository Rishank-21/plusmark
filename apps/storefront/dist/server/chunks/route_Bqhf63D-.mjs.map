---
// Save control (Req 15.4): on every Product_Card and PDP. Shown only while the wishlists Optional_Feature is on.
import { buildFeatures, rq } from '../../lib/requests/page-data';
import '../../styles/requests.css';
import type { Locale } from '../../lib/i18n';
interface Props { productId: string; title: string; locale: Locale; class?: string }
const { productId, title, locale, class: cls = '' } = Astro.props;
const on = buildFeatures().wishlists;
---
{on && (
  <button type="button" class={`pm-save ${cls}`.trim()} data-pm-save={productId} data-locale={locale}
    data-label-save={rq(locale, 'saveFor', { title })} data-label-saved={rq(locale, 'savedFor', { title })} aria-pressed="false"
    aria-label={rq(locale, 'saveFor', { title })}>
    <span aria-hidden="true" data-pm-save-icon>♡</span> <span data-pm-save-text>{rq(locale, 'save')}</span>
  </button>
  <script>
    import '../../scripts/saved';
  </script>
)}
