---
// The product page of one handle: layout plus the PDP. Used by /product/<handle> and /hi/product/<handle>.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdpPage from './PdpPage.astro';
import { loadPdpData, loadReviews } from '../../lib/pdp-data';
import { loadShellData } from '../../lib/shell-data';
import { parseCategories, plainText, componentSwitches, parsePdpProduct, parsePdpReviews, categoryChain, categoryPath } from '../../lib/pdp';
import { breadcrumbJsonLd, metaDescription, productJsonLd } from '../../lib/seo';
import { localizePath } from '../../lib/shell-nav';
import type { Locale } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import { resolveLayout } from '../../lib/presets';
import categoriesJson from '../../data/categories.json';

interface Props { locale: Locale; handle: string; record?: Record<string, unknown>; categoriesData?: unknown }
// An On_Demand_Page passes the record and the category list that it read from the Store_API (design KD-5); a Static_Page reads the build data.
const { locale, handle, record, categoriesData } = Astro.props;
const data = loadPdpData();
const product = record ?? data.products.find((p) => p.handle === handle);
if (!product) throw new Error(`No product with handle "${handle}" in the build data`);
const reviews = record ? { enabled: false, reviews: [] } : await loadReviews(String(product.id));
const categoriesSource = categoriesData ?? categoriesJson;
const shell = loadShellData();
const title = `${String(product.title ?? '')} | ${shell.brand.name}`;
const description = plainText(String(product.description ?? '') || String(product.subtitle ?? ''));
const bottomBar = componentSwitches(data.settings).sticky_buy_bar !== false;
const layout = resolveLayout(data.settings);
const path = localizePath(locale, `/product/${encodeURIComponent(handle)}`);
const model = parsePdpProduct(product, data.currency);
const rows = parseCategories(categoriesSource);
const site = Astro.site ? String(Astro.site) : '';
const pageUrl = Astro.site ? new URL(path, Astro.site).href : path;
const firstCat = model?.categories[0];
const crumbs = [
  { label: t(locale, 'plp.home'), href: localizePath(locale, '/') },
  ...(firstCat ? categoryChain(rows, firstCat.id).map((c) => ({ label: c.name, href: localizePath(locale, `/shop/${categoryPath(rows, c.id)}`) })) : []),
  { label: model?.title ?? '', href: '' },
];
const ld = model
  ? [productJsonLd({ model, url: pageUrl, brand: shell.brand.name, reviews: reviews.enabled ? parsePdpReviews(reviews.reviews) : [], raw: product }), breadcrumbJsonLd(crumbs, pageUrl, site)]
  : [];
---
<BaseLayout title={title} locale={locale} description={metaDescription(description, title)} image={model?.images[0]?.url} ogType="product" jsonLd={ld} path={path} bottomBar={bottomBar} shell={shell}>
  <PdpPage
    locale={locale}
    product={product}
    catalog={data.products}
    categories={rows}
    settings={data.settings}
    offers={data.offers}
    rules={data.rules}
    currency={data.currency}
    regionId={data.regionId}
    reviews={reviews}
    badgePriority={layout.badgePriority}
    requireUnitPrice={layout.requireUnitPrice}
    pdpBlocks={layout.pdpBlocks}
  />
</BaseLayout>
