---
// Shows a tested Persuasion_Component to one Experiment variant only (Req 19.5, 19.6); untested components render as they are.
// styles/experiments.css hides it from the other variant before the first paint. The element is also the area
// that the Exposure observer watches (scripts/experiments.ts).
interface Props { component: string; showTo?: 'treatment' | 'control' }
const { component, showTo } = Astro.props;
---
{showTo ? <div data-pm-component={component} data-pm-show={showTo}><slot /></div> : <slot />}
