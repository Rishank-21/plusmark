---
// Back_In_Stock_Alert control (Req 11.16): hidden until the chosen variant has a Sellable_Quantity of 0.
import RequestSection from './RequestSection.astro';
import FormEnd from './FormEnd.astro';
import { rq } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; productId: string; variantIds: string[]; liveUrl: string | null }
const { locale, productId, variantIds, liveUrl } = Astro.props;
const id = 'pm-bis';
---
<div data-pm-bis data-product-id={productId} data-variant-ids={JSON.stringify(variantIds)} data-live-url={liveUrl ?? undefined} hidden>
  <RequestSection locale={locale} id={id} heading={rq(locale, 'bis.heading')} intro={rq(locale, 'bis.text')}>
    <form class="pm-request__form" data-pm-form data-action="back_in_stock" novalidate>
      <input type="hidden" name="variant_id" value="" data-bis-variant />
      <div class="pm-field"><label class="pm-label" for={`${id}-email`}>{rq(locale, 'bis.email')}</label>
        <input class="pm-input" id={`${id}-email`} name="email" type="email" inputmode="email" maxlength="254" autocomplete="email" required /></div>
      <FormEnd locale={locale} submit={rq(locale, 'bis.submit')} />
    </form>
    <div class="pm-request__done" data-pm-done hidden></div>
  </RequestSection>
</div>
