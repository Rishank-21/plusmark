---
// Phone bottom navigation (Req 4.2, 4.3): Home, Categories, Search, Cart (with count), Account.
// Hidden from 768 px, and while the page shows a bottom action bar (see shell.css).
import Icon from '../ui/Icon.astro';
import CartCount from './CartCount';
import { t, type Locale } from '../../lib/i18n';
import { currentNav, localizePath } from '../../lib/shell-nav';

interface Props { locale: Locale; pathname: string }
const { locale, pathname } = Astro.props;
const current = currentNav(pathname);
const link = (key: 'home' | 'search' | 'cart' | 'account') => ({
  href: localizePath(locale, key === 'home' ? '/' : `/${key}`),
  'aria-current': current === key ? ('page' as const) : undefined,
});
---
<nav class="pm-bottomnav" data-pm-bottomnav aria-label={t(locale, 'nav.quickLinks')}>
  <ul>
    <li>
      <a class="pm-bottomnav__item" {...link('home')}><Icon name="home" /><span>{t(locale, 'nav.home')}</span></a>
    </li>
    <li>
      <button type="button" class="pm-bottomnav__item" data-pm-open="pm-menu" aria-haspopup="dialog"><Icon name="menu" /><span>{t(locale, 'nav.categories')}</span></button>
    </li>
    <li>
      <a class="pm-bottomnav__item" {...link('search')}><Icon name="search" /><span>{t(locale, 'nav.search')}</span></a>
    </li>
    <li>
      <a class="pm-bottomnav__item pm-header__cart" {...link('cart')}>
        <Icon name="cart" /><span>{t(locale, 'nav.cart')}</span>
        <CartCount client:idle label={t(locale, 'nav.cartItems')} />
      </a>
    </li>
    <li>
      <a class="pm-bottomnav__item" {...link('account')}><Icon name="user" /><span>{t(locale, 'nav.account')}</span></a>
    </li>
  </ul>
</nav>
