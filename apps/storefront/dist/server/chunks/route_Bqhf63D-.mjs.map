---
import RequestSection from './RequestSection.astro';
import FormEnd from './FormEnd.astro';
import { rq } from '../../lib/requests/page-data';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale; replyHours: number; productId?: string; idPrefix?: string }
const { locale, replyHours, productId, idPrefix = 'pm-enquiry' } = Astro.props;
---
<RequestSection locale={locale} id={idPrefix} heading={rq(locale, productId ? 'enq.heading' : 'enq.headingGeneral')}>
  <form class="pm-request__form" data-pm-form data-action="submit_enquiry" data-product-id={productId} data-reply-hours={String(replyHours)} novalidate>
    <div class="pm-field"><label class="pm-label" for={`${idPrefix}-name`}>{rq(locale, 'enq.name')}</label>
      <input class="pm-input" id={`${idPrefix}-name`} name="name" maxlength="120" autocomplete="name" required /></div>
    <div class="pm-field"><label class="pm-label" for={`${idPrefix}-email`}>{rq(locale, 'enq.email')}</label>
      <input class="pm-input" id={`${idPrefix}-email`} name="email" type="email" inputmode="email" maxlength="254" autocomplete="email" required /></div>
    <div class="pm-field"><label class="pm-label" for={`${idPrefix}-phone`}>{rq(locale, 'enq.phone')}</label>
      <input class="pm-input" id={`${idPrefix}-phone`} name="phone" type="tel" inputmode="tel" maxlength="30" autocomplete="tel" /></div>
    <div class="pm-field"><label class="pm-label" for={`${idPrefix}-message`}>{rq(locale, 'enq.message')}</label>
      <textarea class="pm-input" id={`${idPrefix}-message`} name="message" rows="4" maxlength="4000" required></textarea></div>
    <FormEnd locale={locale} submit={rq(locale, 'enq.submit')} />
  </form>
  <div class="pm-request__done" data-pm-done hidden></div>
</RequestSection>
