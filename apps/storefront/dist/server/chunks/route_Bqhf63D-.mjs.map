---
import { pictureData, type ImageSlot, type ImageSource } from '../../lib/images';

interface Props {
  image: ImageSource;
  slot: ImageSlot;
  /** True only for the largest image of the first viewport (hero, first PLP row, first gallery image). */
  priority?: boolean;
  class?: string;
  mediaBase?: string;
}
const { image, slot, priority = false, class: className, mediaBase = import.meta.env.PUBLIC_MEDIA_BASE ?? '' } = Astro.props;
const p = pictureData(image, { mediaBase, slot, priority });
---
{p.hasVariants ? (
  <picture class={className}>
    <source type="image/webp" srcset={p.webpSrcset} sizes={p.sizes} data-sd={p.sdWebp} />
    <img
      src={p.src}
      srcset={p.jpegSrcset}
      sizes={p.sizes}
      width={p.width}
      height={p.height}
      alt={p.alt}
      loading={p.loading}
      decoding={p.decoding}
      fetchpriority={p.fetchpriority}
      data-sd={p.sdJpeg}
    />
  </picture>
) : (
  <img class={className} src={p.src} width={p.width} height={p.height} alt={p.alt} loading={p.loading} decoding={p.decoding} fetchpriority={p.fetchpriority} />
)}
