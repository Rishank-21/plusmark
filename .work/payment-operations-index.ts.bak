// payment-operations: POST. Runs queued captures/refunds/voids, payment incidents and unknown-outcome reconciliation (Req 10.7, 12.7).
// Meant for the Scheduler or an operator. Requires the service role key as the Bearer token.
// Env: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, PAYMENT_PROVIDER_TIMEOUT_MS (optional).
import { createClient } from "jsr:@supabase/supabase-js@2";
import { getPaymentProvider } from "../_shared/payments/index.ts";
import { DEFAULT_TIMEOUT_MS, type Operation, runOnce } from "./operations.ts";

const json = (status: number, body: unknown) =>
  new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json", "Cache-Control": "no-store" } });

function equal(a: string, b: string): boolean {
  if (a.length !== b.length) return false;
  let d = 0;
  for (let i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}

Deno.serve(async (req: Request): Promise<Response> => {
  if (req.method !== "POST") return json(405, { error: { code: "method_not_allowed", message: "Use POST." } });
  const url = Deno.env.get("SUPABASE_URL");
  const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
  if (!url || !serviceKey) return json(503, { error: { code: "not_configured", message: "Payments are not configured." } });
  const bearer = (req.headers.get("Authorization") ?? "").replace(/^Bearer\s+/i, "");
  if (!equal(bearer, serviceKey)) return json(401, { error: { code: "unauthorized", message: "Service credentials required." } });

  const admin = createClient(url, serviceKey, { auth: { persistSession: false, autoRefreshToken: false } });
  const rpc = async (fn: string, args: Record<string, unknown> = {}) => {
    const r = await admin.schema("api").rpc(fn, args);
    if (r.error) throw new Error(`${fn}: ${r.error.message}`);
    const d = r.data as Record<string, unknown>;
    if (d && typeof d === "object" && "error" in d) throw new Error(`${fn}: ${JSON.stringify(d.error)}`);
    return d;
  };
  try {
    const report = await runOnce({
      timeoutMs: Number(Deno.env.get("PAYMENT_PROVIDER_TIMEOUT_MS")) || DEFAULT_TIMEOUT_MS,
      getProvider: (id) => {
        try {
          return getPaymentProvider(id, (n) => Deno.env.get(n));
        } catch {
          return null; // credentials missing: nothing is sent
        }
      },
      db: {
        claimIncident: async () => {
          const d = await rpc("service_claim_payment_incident");
          return d.claimed ? (d.operation as Operation) : null;
        },
        list: async (status, olderThanSeconds, limit) => {
          const d = await rpc("service_list_provider_operations", { p_status: status, p_older_than_seconds: olderThanSeconds, p_limit: limit });
          return d.operations as Operation[];
        },
        claim: async (id) => {
          const d = await rpc("service_claim_provider_operation", { p_id: id });
          return d.claimed ? (d.operation as Operation) : null;
        },
        finish: async (id, outcome, providerRef, error) => {
          await rpc("service_finish_provider_operation", { p_id: id, p_outcome: outcome, p_provider_ref: providerRef, p_error: error });
        },
      },
    });
    return json(200, report);
  } catch {
    return json(500, { error: { code: "internal_error", message: "The run failed; the next run continues." } });
  }
});
