en\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"© \\\",2026,\\\" \\\",\\\"Plusmark Display System\\\",\\\". All rights reserved.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-2xl lg:text-right\\\",\\\"children\\\":[\\\"Made-to-order sizes show as price on request until Plusmark confirms the figure. Catalogue reference:\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://plusmarkboards.com/\\\",\\\"className\\\":\\\"text-shell-on/80 underline decoration-shell-on/30 underline-offset-4 hover:text-shell-on\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"children\\\":\\\"plusmarkboards.com\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"21:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"bg-page border-b border-line py-12 lg:py-16\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"pm-shell flex flex-col gap-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"nav\\\",null,{\\\"aria-label\\\":\\\"Breadcrumb\\\",\\\"children\\\":[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center gap-x-1.5 gap-y-1 text-caption text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Home-0\\\",{\\\"className\\\":\\\"flex items-center gap-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"-my-2.5 inline-flex min-h-10 items-center rounded-xs py-2.5 transition-colors hover:text-ink hover:underline hover:decoration-line-strong hover:underline-offset-4\\\",\\\"children\\\":\\\"Home\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-chevron-right size-3 text-hair-strong\\\",\\\"aria-hidden\\\":true,\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mthhwq\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\"}],\\\"$undefined\\\"]}]]}],[\\\"$\\\",\\\"li\\\",\\\"FAQ-1\\\",{\\\"className\\\":\\\"flex items-center gap-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"aria-current\\\":\\\"page\\\",\\\"className\\\":\\\"text-ink\\\",\\\"children\\\":\\\"FAQ\\\"}],false]}]]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex min-w-0 flex-col gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"balance max-w-[24ch] font-display font-extrabold text-ink text-h1\\\",\\\"children\\\":\\\"Questions about boards, sizes and supply\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"pretty max-w-reading text-body leading-relaxed text-muted\\\",\\\"children\\\":\\\"Search the Plusmark FAQ by material, size, surface, delivery or returns. Where the business has not published an answer, the entry says so instead of filling the gap with a guessed policy.\\\"}],\\\"$undefined\\\"]}],\\\"$undefined\\\"]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"22:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"faq-explorer\\\",\\\"className\\\":\\\"scroll-mt-48 lg:scroll-mt-52 py-16 lg:py-24 border-b border-line bg-page\\\",\\\"aria-labelledby\\\":\\\"faq-explorer-heading\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"pm-shell\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between md:gap-8 lg:mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex min-w-0 flex-col gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"faq-explorer-heading\\\",\\\"className\\\":\\\"balance max-w-[24ch] font-display font-extrabold text-ink text-h2\\\",\\\"children\\\":\\\"Find an answer\\\"}],\\\"$undefined\\\"]}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"items\\\":[{\\\"id\\\":\\\"faq-1\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"Which products does Plusmark manufacture?\\\",\\\"answer\\\":\\\"Plusmark manufactures white boards, chalk boards, notice boards, ceramic boards, magnetic boards, school benches and all types of board stands, along with clipboards, exam pads and specialty display boards.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-2\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"What is the difference between the Metallic Premium, Eco Premium, Deluxe Standard and Eco Regular series?\\\",\\\"answer\\\":\\\"Metallic Premium boards use heavy-duty aluminium anodized framing with Signature Dual-Tone Corners and are built for intensive daily institutional use. Eco Premium boards use premium-grade materials with ABS Dual-Tone Corners for regular institutional use. Deluxe Standard boards have Electroplated Chrome Corners and are dependable for everyday use. Eco Regular boards have a lightweight frame with standard plastic corners for light use and budget-friendly applications.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-3\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"What is the difference between an HPL white board and a melamine white board?\\\",\\\"answer\\\":\\\"Metallic Premium and Eco Premium white boards use a High Gloss Marker Grade HPL Sheet — an ultra-smooth, durable surface for effortless writing and easy erasing. Deluxe Standard and Eco Regular white boards use a High Gloss Melamine Writing Surface, which is smooth, easy to clean and suited to regular or lighter use.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-4\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"Are Plusmark chalk boards glare-free?\\\",\\\"answer\\\":\\\"Yes. Plusmark chalk boards use Chalk Grade HPL Sheet surfaces that are non-reflective and glare-free, with clear visibility from all angles. The Metallic Premium and Eco Premium series use Hardcore Chalk Grade HPL Sheet with enhanced scratch resistance.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-5\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"Should I choose a magnetic board or a ceramic board?\\\",\\\"answer\\\":\\\"Resin Coated Steel Magnetic Boards accept magnets, charts and holders and come in white (marker) and green (chalk) surfaces. Ceramic Steel Magnetic Boards use a ceramic steel / porcelain enamel steel surface that is hard and non-porous — suitable for continuous writing and frequent cleaning, for a very long product life.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-6\\\",\\\"section\\\":\\\"Products \\u0026 Materials\\\",\\\"question\\\":\\\"What surfaces are available for notice boards?\\\",\\\"answer\\\":\\\"Notice boards are available with 2 mm Blazer Cloth or Super Fine Velvet Cloth over soft, pin-friendly cores, in multiple colours. Cork and combination (white board + fabric) boards are also available.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-7\\\",\\\"section\\\":\\\"Sizes \\u0026 Customisation\\\",\\\"question\\\":\\\"Which board sizes are available?\\\",\\\"answer\\\":\\\"Standard sizes run from small 1 × 1 ft desk boards up to 8 × 4 ft classroom and lecture-hall boards. Metallic Premium and Deluxe Standard boards are made from 3 × 4 ft up to 8 × 4 ft; Eco Premium and Eco Regular boards from 1.5 × 2 ft up to 8 × 4 ft. Larger or non-standard sizes are made to order as per customer requirement. Just send an enquiry with the size you need.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-8\\\",\\\"section\\\":\\\"Sizes \\u0026 Customisation\\\",\\\"question\\\":\\\"Can I order a custom design or layout?\\\",\\\"answer\\\":\\\"Yes. Dry Wipe Schedule Boards can be made in any design and any size to your sketch; fabric notice boards are available in your preferred fabric colour and layout; practice boards can have line marking as per school requirement; and acrylic folder display boards are made with folder size and quantity as required.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-9\\\",\\\"section\\\":\\\"Sizes \\u0026 Customisation\\\",\\\"question\\\":\\\"What do I need to share for a custom schedule board?\\\",\\\"answer\\\":\\\"Please share the quantity of boards, the sizes and a sketch of the board. Sketches can be sent in CorelDRAW, Photoshop or Word format. If Plusmark prepares the design, additional charges apply.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-10\\\",\\\"section\\\":\\\"Supply \\u0026 Ordering\\\",\\\"question\\\":\\\"Does Plusmark supply across India?\\\",\\\"answer\\\":\\\"Yes. Plusmark operates across India and supplies products nationwide to schools, colleges, coaching centres, offices, dealers, distributors, factories and government institutions.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-11\\\",\\\"section\\\":\\\"Supply \\u0026 Ordering\\\",\\\"question\\\":\\\"Do Plusmark products come with a warranty?\\\",\\\"answer\\\":\\\"Plusmark provides warranty on all products it manufactures. Please confirm the warranty terms for your order with our authorized distributor or marketing executive.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"faq-12\\\",\\\"section\\\":\\\"Supply \\u0026 Ordering\\\",\\\"question\\\":\\\"Where is Plusmark located?\\\",\\\"answer\\\":\\\"Plusmark Display System is located at Narolgam, Ahmedabad, Gujarat. The full address and map are on the Contact page.\\\",\\\"source\\\":\\\"verified\\\"},{\\\"id\\\":\\\"pending-freight\\\",\\\"section\\\":\\\"Delivery \\u0026 policies\\\",\\\"question\\\":\\\"What will freight cost and how long will delivery take?\\\",\\\"answer\\\":\\\"Plusmark has not published a common freight rate or delivery estimate. Both depend on the order and destination and are confirmed when the invoice is raised.\\\",\\\"source\\\":\\\"demo\\\"},{\\\"id\\\":\\\"pending-returns\\\",\\\"section\\\":\\\"Delivery \\u0026 policies\\\",\\\"question\\\":\\\"What return window and refund timeline apply?\\\",\\\"answer\\\":\\\"The return window, eligibility rules and refund timeline have not been signed off for this storefront. Confirm the terms with Plusmark before ordering.\\\",\\\"source\\\":\\\"demo\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"$L2d\\\",null,{\\\"children\\\":[\\\"$L2e\\\",[\\\"$\\\",\\\"$L2f\\\",null,{\\\"promise\\\":\\\"$@30\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"path\\\",\\\"vv11sd\\\",{\\\"d\\\":\\\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\\\"}]\\n2a:[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://wa.me/+919913967888\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"footer-contact\\\",\\\"children\\\":\\\"WhatsApp Plusmark\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-sans text-label font-medium uppercase tracking-[0.14em] text-shell-on/55\\\",\\\"children\\\":\\\"Policies\\\"}],[[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"flex flex-col gap-2.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/policies/shipping\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/policies/shipping\\\",\\\"className\\\":\\\"inline-block rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\\\",\\\"children\\\":\\\"Shipping policy\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/policies/returns\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/policies/returns\\\",\\\"className\\\":\\\"inline-block rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\\\",\\\"children\\\":\\\"Returns \\u0026 refunds\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/policies