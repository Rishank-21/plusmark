,\"frame\":null,\"corners\":null,\"magnetic\":false,\"doubleSided\":false,\"boardType\":\"n/a\",\"surfaceKind\":\"other\",\"usage\":\"Clipboard use with a clear acrylic base\",\"blurb\":\"Crystal Clear Base Clipboard. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\",\"description\":\"The Crystal Clear Base Clipboard uses a crystal-clear acrylic base with glass-like clarity and a modern appeal. The chrome electroplated clip has a rust-resistant finish, and dual-side cap rivets keep a uniform look on both sides.\\n\\nThe heavy-duty clear acrylic has high impact strength and is shatter-resistant. It is available in two sizes and four variants.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Base — Crystal clear acrylic with glass-like clarity\",\"Clip — Chrome electroplated, rust-resistant finish\",\"Rivets — Dual-side cap rivets for a uniform look on both sides\",\"Build — Heavy-duty clear acrylic with high impact strength and shatter resistance\",\"Options — Two sizes and four variants\"],\"customisation\":null,\"media\":[\"$23:0:props:children:props:children:1:props:children:1:props:children:props:children:props:asset\"],\"videoId\":null,\"variants\":[{\"id\":\"crystal-clear-base-clipboard--standard-size\",\"productId\":\"crystal-clear-base-clipboard\",\"sku\":\"PM-STD-CLI-STANDA\",\"size\":{\"id\":\"standard-size\",\"label\":\"Standard size\",\"widthCm\":null,\"heightCm\":null},\"priceMode\":\"fixed\",\"priceInr\":490,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"crystal-clear-base-clipboard--made-to-order\",\"productId\":\"crystal-clear-base-clipboard\",\"sku\":\"PM-STD-CLI-MADETO\",\"size\":{\"id\":\"made-to-order\",\"label\":\"Made to order\",\"widthCm\":nul