$L32\",null,{\"product\":{\"id\":\"combination-board\",\"slug\":\"combination-board\",\"name\":\"Combination Board\",\"categoryId\":\"notice-boards\",\"seriesId\":null,\"subcategoryIds\":[],\"surface\":\"Dry wipe white board one side, fabric notice board on the other\",\"frame\":null,\"corners\":null,\"magnetic\":false,\"doubleSided\":false,\"boardType\":\"n/a\",\"surfaceKind\":\"pin-up\",\"usage\":\"Marker writing and pin-up display in one board\",\"blurb\":\"Combination Board: Dry wipe white board one side, fabric notice board on the other. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\",\"description\":\"The Combination Board carries a dry wipe white board on one side and a fabric notice board on the other, so marker writing and pin-up display sit in a single board.\\n\\nThe marker face erases cleanly, while the durable fabric takes repeated pinning and removal without losing grip. It is available in Metallic Premium, Eco Premium and Deluxe frame variants.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Surface — Dry wipe white board on one side, fabric notice board on the other\",\"Function — Marker writing plus pin-up display in a single board\",\"Performance — Smooth marker writing with easy erase and a durable fabric surface for repeated pin use\",\"Durability — Long-lasting surface performance for regular notice display\",\"Design options — Metallic Premium, Eco Premium and Deluxe frame variants\"],\"customisation\":null,\"media\":[{\"publicId\":\"plusmark/products/combination-board\",\"alt\":\"Combination Board - Notice Board by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"}],\"videoId\":null,\"variants\":[{\"id\":\"combination-board--standard-size\",\"productId\":\"combination-board\",\"sku\":\"PM-S