grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col items-start gap-3 sm:gap-5 lg:sticky lg:top-40 lg:self-start\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"faq-heading\\\",\\\"className\\\":\\\"max-w-[14ch] font-display text-[1.375rem] font-extrabold leading-7 text-ink sm:text-h2 sm:leading-tight\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-[36ch] font-sans text-body-sm leading-relaxed text-muted\\\",\\\"children\\\":\\\"Answers are the ones published by Plusmark. Anything that depends on a custom size is confirmed before you order.\\\"}],[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/faq\\\",\\\"className\\\":\\\"group mt-1 inline-flex items-center gap-2 border-b border-ink/30 pb-1 font-sans text-body-sm font-normal text-ink transition-colors hover:border-ink\\\",\\\"children\\\":[\\\"All questions\\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-arrow-right size-4 transition-transform group-hover:translate-x-0.5\\\",\\\"aria-hidden\\\":true,\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1ays0h\\\",{\\\"d\\\":\\\"M5 12h14\\\"}],[\\\"$\\\",\\\"path\\\",\\\"xquz4c\\\",{\\\"d\\\":\\\"m12 5 7 7-7 7\\\"}],\\\"$undefined\\\"]}]]}]]}],[\\\"$\\\",\\\"$L44\\\",null,{\\\"items\\\":[{\\\"id\\\":\\\"faq-7\\\",\\\"question\\\":\\\"Which board sizes are available?\\\",\\\"answer\\\":\\\"Standard sizes run from small 1 × 1 ft desk boards up to 8 × 4 ft classroom and lecture-hall boards. Metallic Premium and Deluxe Standard boards are made from 3 × 4 ft up to 8 × 4 ft; Eco Premium and Eco Regular boards from 1.5 × 2 ft up to 8 × 4 ft. Larger or non-standard sizes are made to order as per customer requirement. Just send an enquiry with the size you need.\\\"},{\\\"id\\\":\\\"faq-5\\\",\\\"question\\\":\\\"Should I choose a magnetic board or a ceramic board?\\\",\\\"answer\\\":\\\"Resin Coated Steel Magnetic Boards accept magnets, charts and holders and come in white (marker) and green (chalk) surfaces. Ceramic Steel Magnetic Boards use a ceramic steel / porcelain enamel steel surface that is hard and non-porous — suitable for continuous writing and frequent cleaning, for a very long product life.\\\"},{\\\"id\\\":\\\"faq-10\\\",\\\"question\\\":\\\"Does Plusmark supply across India?\\\",\\\"answer\\\":\\\"Yes. Plusmark operates across India and supplies products nationwide to schools, colleges, coaching centres, offices, dealers, distributors, factories and government institutions.\\\"},{\\\"id\\\":\\\"faq-11\\\",\\\"question\\\":\\\"Do Plusmark products come with a warranty?\\\",\\\"answer\\\":\\\"Plusmark provides warranty on all products it manufactures. Please confirm the warranty terms for your order with our authorized distributor or marketing executive.\\\"},{\\\"id\\\":\\\"faq-8\\\",\\\"question\\\":\\\"Can I order a custom design or layout?\\\",\\\"answer\\\":\\\"Yes. Dry Wipe Schedule Boards can be made in any design and any size to your sketch; fabric notice boards are available in your preferred fabric colour and layout; practice boards can have line marking as per school requirement; and acrylic folder display boards are made with folder size and quantity as required.\\\"},{\\\"id\\\":\\\"faq-3\\\",\\\"question\\\":\\\"What is the difference between an HPL white board and a melamine white board?\\\",\\\"answer\\\":\\\"Metallic Premium and Eco Premium white boards use a High Gloss Marker Grade HPL Sheet — an ultra-smooth, durable surface for effortless writing and easy erasing. Deluxe Standard and Eco Regular white boards use a High Gloss Melamine Writing Surface, which is smooth, easy to clean and suited to regular or lighter use.\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"$L45\\\",null,{\\\"children\\\":[\\\"$L46\\\",[\\\"$\\\",\\\"$L47\\\",null,{\\\"promise\\\":\\\"$@48\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2f:[\\\"$\\\",\\\"path\\\",\\\"vv11sd\\\",{\\\"d\\\":\\\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\\\"}]\\n30:[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://wa.me/+919913967888\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"footer-contact\\\",\\\"children\\\":\\\"WhatsApp Plusmark\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"31:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-sans text-label font-medium uppercase tracking-[0.14em] text-shell-on/55\\\",\\\"children\\\":\\\"Policies\\\"}],[[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"flex flex-col gap-2.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/policies/shipping\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/policies/shipping\\\",\\\"className\\\":\\\"inline-block rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\\\",\\\"children\\\":\\\"Shipping policy\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/policies/returns\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/policies/returns\\\",\\\"className\\\":\\\"inline-block rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\\\",\\\"children\\\":\\\"Returns \\u0026 refunds\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/policies/privacy\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"href\\\":\\\"/policies/privacy\\\",\\\"className\\\":\\\"inline-block rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\\\",\\\"children\\\":\\\"Privacy policy\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/pol