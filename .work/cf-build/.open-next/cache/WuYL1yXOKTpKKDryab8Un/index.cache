0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></span><blockquote class=\"mt-3 line-clamp-4 flex-1 text-body-sm leading-relaxed text-ink sm:text-body\">“<!-- -->One month ago me purchased 8*4 size 10 nos white board. Superb quality and fast service.<!-- -->”</blockquote><figcaption class=\"mt-3 text-caption text-muted\"><span class=\"font-medium text-ink\">Abhi Chaudhary</span> · Google review</figcaption></figure><figure class=\"flex h-full w-[86%] shrink-0 snap-start flex-col rounded-xl border border-line bg-surface p-5 shadow-card sm:w-auto sm:p-6\"><span class=\"flex items-center gap-1 text-rating\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star size-3.5 fill-current\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></span><blockquote class=\"mt-3 line-clamp-4 flex-1 text-body-sm leading-relaxed text-ink sm:text-body\">“<!-- -->Good quality. Best finishing. Easy to write.<!-- -->”</blockquote><figcaption class=\"mt-3 text-caption text-muted\"><span class=\"font-medium text-ink\">Chaudhary Bharat</span> · Google review</figcaption></figure></div></div></section><section class=\"bg-page py-10 lg:py-24\" aria-labelledby=\"faq-heading\"><div class=\"pm-shell grid gap-6 sm:gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20\"><div class=\"flex flex-col items-start gap-3 sm:gap-5 lg:sticky lg:top-40 lg:self-start\"><h2 id=\"faq-heading\" class=\"max-w-[14ch] font-display text-[1.375rem] font-extrabold leading-7 text-ink sm:text-h2 sm:leading-tight\">Frequently asked questions</h2><p class=\"max-w-[36ch] font-sans text-body-sm leading-relaxed text-muted\">Answers are the ones published by Plusmark. Anything that depends on a custom size is confirmed before you order.</p><a class=\"group mt-1 inline-flex items-center gap-2 border-b border-ink/30 pb-1 font-sans text-body-sm font-normal text-ink transition-colors hover:border-ink\" href=\"/faq\">All questions<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4 transition-transform group-hover:translate-x-0.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"flex flex-col gap-2\"><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-7-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"_R_ainkpfdb_-faq-7-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-primary-strong\">Which board sizes are available?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-primary bg-primary text-onprimary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-minus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-7-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-7-button\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Standard sizes run from small 1 × 1 ft desk boards up to 8 × 4 ft classroom and lecture-hall boards. Metallic Premium and Deluxe Standard boards are made from 3 × 4 ft up to 8 × 4 ft; Eco Premium and Eco Regular boards from 1.5 × 2 ft up to 8 × 4 ft. Larger or non-standard sizes are made to order as per customer requirement. Just send an enquiry with the size you need.</div></div><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-5-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_ainkpfdb_-faq-5-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-ink\">Should I choose a magnetic board or a ceramic board?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-line bg-surface text-ink group-hover:border-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-5-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-5-button\" hidden=\"\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Resin Coated Steel Magnetic Boards accept magnets, charts and holders and come in white (marker) and green (chalk) surfaces. Ceramic Steel Magnetic Boards use a ceramic steel / porcelain enamel steel surface that is hard and non-porous — suitable for continuous writing and frequent cleaning, for a very long product life.</div></div><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-10-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_ainkpfdb_-faq-10-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-ink\">Does Plusmark supply across India?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-line bg-surface text-ink group-hover:border-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-10-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-10-button\" hidden=\"\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Yes. Plusmark operates across India and supplies products nationwide to schools, colleges, coaching centres, offices, dealers, distributors, factories and government institutions.</div></div><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-11-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_ainkpfdb_-faq-11-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-ink\">Do Plusmark products come with a warranty?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-line bg-surface text-ink group-hover:border-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-11-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-11-button\" hidden=\"\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Plusmark provides warranty on all products it manufactures. Please confirm the warranty terms for your order with our authorized distributor or marketing executive.</div></div><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-8-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_ainkpfdb_-faq-8-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-ink\">Can I order a custom design or layout?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-line bg-surface text-ink group-hover:border-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-8-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-8-button\" hidden=\"\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Yes. Dry Wipe Schedule Boards can be made in any design and any size to your sketch; fabric notice boards are available in your preferred fabric colour and layout; practice boards can have line marking as per school requirement; and acrylic folder display boards are made with folder size and quantity as required.</div></div><div class=\"rounded-xl border border-line bg-surface px-5\"><h3><button id=\"_R_ainkpfdb_-faq-3-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_ainkpfdb_-faq-3-panel\" class=\"group flex w-full items-center justify-between gap-6 py-5 text-left\"><span class=\"font-display text-h4 font-semibold leading-snug transition-colors sm:text-h3 text-ink\">What is the difference between an HPL white board and a melamine white board?</span><span class=\"flex shrink-0 items-center gap-4\"><span class=\"flex size-8 items-center justify-center rounded-full border transition-colors border-line bg-surface text-ink group-hover:border-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></span></span></button></h3><div id=\"_R_ainkpfdb_-faq-3-panel\" role=\"region\" aria-labelledby=\"_R_ainkpfdb_-faq-3-button\" hidden=\"\" class=\"max-w-reading pb-6 pr-0 text-body-sm leading-relaxed text-muted sm:pr-14\">Metallic Premium and Eco Premium white boards use a High Gloss Marker Grade HPL Sheet — an ultra-smooth, durable surface for effortless writing and easy erasing. Deluxe Standard and Eco Regular white boards use a High Gloss Melamine Writing Surface, which is smooth, easy to clean and suited to regular or lighter use.</div></div></div></div></section><!--$--><!--/$--></main><footer class=\"mt-10 bg-shell text-shell-on md:mt-16\"><div class=\"pm-shell py-9 md:py-14 lg:py-16\"><div class=\"grid gap-7 md:grid-cols-2 md:gap-10 lg:grid-cols-[1.35fr_1fr_1fr_1fr] lg:gap-12\"><div class=\"flex flex-col gap-4 md:col-span-2 lg:col-span-1\"><a class=\"w-fit rounded-xs\" aria-label=\"Plusmark home\" href=\"/\"><img alt=\"Plusmark\" loading=\"lazy\" width=\"1304\" height=\"261\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto md:h-12\" style=\"color:transparent\" src=\"/images/plusmark/brand/plusmark-white.png\"/></a><p class=\"max-w-sm text-body-sm le