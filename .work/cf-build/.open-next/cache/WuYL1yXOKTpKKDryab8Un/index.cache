e\":\"flex min-h-11 items-center rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\",\"children\":\"White Boards\"}]}],[\"$\",\"li\",\"chalk-boards\",{\"children\":[\"$\",\"$L9\",null,{\"href\":\"/shop/chalk-boards\",\"className\":\"flex min-h-11 items-center rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\",\"children\":\"Chalk Boards\"}]}],[\"$\",\"li\",\"double-sided-boards\",{\"children\":[\"$\",\"$L9\",null,{\"href\":\"/shop/double-sided-boards\",\"className\":\"flex min-h-11 items-center rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\",\"children\":\"Double-Sided Boards\"}]}],[\"$\",\"li\",\"notice-boards\",{\"children\":[\"$\",\"$L9\",null,{\"href\":\"/shop/notice-boards\",\"className\":\"flex min-h-11 items-center rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\",\"children\":\"Notice Boards\"}]}],[\"$\",\"li\",\"acrylic-door-cover-notice-boards\",{\"children\":[\"$\",\"$L9\",null,{\"href\":\"/shop/acrylic-door-cover-notice-boards\",\"className\":\"flex min-h-11 items-center rounded-xs text-body-sm text-shell-on/72 transition-colors hover:text-shell-on\",\"children\":\"Acrylic Door Cover Notice Boards\"}]}],\"$L14\",\"$L15\"],\"$L16\"]}]}]]}],\"$L17\",\"$L18\",\"$L19\"]}],\"$L1a\"]}]}],\"$L1b\",\"$L1c\"]}]\ne:[\"$\",\"$L1d\",null,{}]\nf:[\"$\",\"$L1e\",null,{}]\n10:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"$L1f\",null,{\"products\":{\"main\":{\"id\":\"metallic-premium-white-board\",\"slug\":\"metallic-premium-white-board\",\"name\":\"Metallic Premium White Board\",\"categoryId\":\"white-boards\",\"seriesId\":\"metallic-premium\",\"subcategoryIds\":[\"white-boards-non-magnetic\"],\"surface\":\"High Gloss Marker Grade HPL Sheet\",\"frame\":\"Aluminium anodized frame, heavy-duty\",\"corners\":\"Signature Dual-Tone corners - red cap over black connector\",\"magnetic\":false,\"doubleSided\":false,\"boardType\":\"non-magnetic\",\"surfaceKind\":\"marker\",\"usage\":\"High-end offices, educational institutions and professional environments\",\"blurb\":\"Metallic Premium White Board: High Gloss Marker Grade HPL Sheet · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\",\"description\":\"The Metallic Premium White Board uses high-quality, durable materials with a High Gloss Marker Grade HPL Sheet. Heavy-duty framing with Signature Dual-Tone Corners gives it a solid, professional build.\\n\\nThe ultra-smooth, high-gloss surface is made for effortless writing and easy erasing. It suits high-end offices, educational institutions and professional environments, and is extremely long-lasting and highly resistant to wear and tear.\\n\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Material — High-quality, durable materials with High Gloss Marker Grade HPL Sheet\",\"Design — Heavy-duty framing with Signature Dual-Tone Corners\",\"Surface — Ultra-smooth, high-gloss surface for effortless writing and easy erasing\",\"Durability — Extremely long-lasting and highly resistant to wear and tear\"],\"customisation\":null,\"media\":[{\"publicId\":\"plusmark/products/metallic-premium-white-board\",\"alt\":\"Metallic Premium White Board - Metallic Premium Whiteboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"}],\"videoId\":\"plusmark/videos/metallic-premium-white-board\",\"variants\":[{\"id\":\"metallic-premium-white-board--3-x-4-ft\",\"productId\":\"metallic-premium-white-board\",\"sku\":\"PM-MP-WHI-3X4FT0\",\"size\":{\"id\":\"3-x-4-ft\",\"label\