 — Economical option designed for light usage\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/eco-regular-white-board\\\",\\\"alt\\\":\\\"Eco Regular Magnetic Board - Eco Regular Whiteboard by Plusmark\\\",\\\"width\\\":1400,\\\"height\\\":1400,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":null,\\\"variants\\\":[{\\\"id\\\":\\\"eco-regular-magnetic-board--1-x-1-ft\\\",\\\"productId\\\":\\\"eco-regular-magnetic-board\\\",\\\"sku\\\":\\\"PM-ER-WHI-1X1FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"1-x-1-ft\\\",\\\"label\\\":\\\"1 x 1 ft\\\",\\\"widthCm\\\":30,\\\"heightCm\\\":30},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":580,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"eco-regular-magnetic-board--2-x-2-ft\\\",\\\"productId\\\":\\\"eco-regular-magnetic-board\\\",\\\"sku\\\":\\\"PM-ER-WHI-2X2FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"2-x-2-ft\\\",\\\"label\\\":\\\"2 x 2 ft\\\",\\\"widthCm\\\":61,\\\"heightCm\\\":61},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":970,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"eco-regular-magnetic-board--2-x-3-ft\\\",\\\"productId\\\":\\\"eco-regular-magnetic-board\\\",\\\"sku\\\":\\\"PM-ER-WHI-2X3FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"2-x-3-ft\\\",\\\"label\\\":\\\"2 x 3 ft\\\",\\\"widthCm\\\":91,\\\"heightCm\\\":61},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":1230,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"eco-regular-magnetic-board--2-x-4-ft\\\",\\\"productId\\\":\\\"eco-regular-magnetic-board\\\",\\\"sku\\\":\\\"PM-ER-WHI-2X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"2-x-4-ft\\\",\\\"label\\\":\\\"2 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":61},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":1490,\\\"compareAtInr\