 — Aluminium frame with Electroplated Chrome Corners\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/deluxe-standard-ceramic-board\\\",\\\"alt\\\":\\\"Deluxe Standard Ceramic Board - Deluxe Standard Whiteboard by Plusmark\\\",\\\"width\\\":2000,\\\"height\\\":1600,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":null,\\\"variants\\\":[{\\\"id\\\":\\\"deluxe-standard-ceramic-board--3-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"sku\\\":\\\"PM-DS-WHI-3X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"3-x-4-ft\\\",\\\"label\\\":\\\"3 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":91},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":2580,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-standard-ceramic-board--4-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"sku\\\":\\\"PM-DS-WHI-4X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"4-x-4-ft\\\",\\\"label\\\":\\\"4 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":122},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":3240,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-standard-ceramic-board--5-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"sku\\\":\\\"PM-DS-WHI-5X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"5-x-4-ft\\\",\\\"label\\\":\\\"5 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":152},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":3900,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-standard-ceramic-board--6-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"sku\\\":\\\"PM-DS-WHI-6X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"6-x-4-ft\\\",\\\"label\\\":\\\"6 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":183},\\\"priceMode\\\":\