 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3.5\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div class=\"min-w-0\"><h3 class=\"font-display text-body font-bold leading-snug text-ink\">Framing</h3><p class=\"mt-1 text-[0.875rem] leading-relaxed text-muted\">Lightweight aluminium framing for economical and practical use</p></div></li><li class=\"flex h-full gap-3 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-line-strong\"><span class=\"mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-strong\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3.5\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div class=\"min-w-0\"><h3 class=\"font-display text-body font-bold leading-snug text-ink\">Cover</h3><p class=\"mt-1 text-[0.875rem] leading-relaxed text-muted\">Transparent acrylic door cover protecting notices from dust and handling</p></div></li><li class=\"flex h-full gap-3 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-line-strong\"><span class=\"mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-strong\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3.5\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div class=\"min-w-0\"><h3 class=\"font-display text-body font-bold leading-snug text-ink\">Locking</h3><p class=\"mt-1 text-[0.875rem] leading-relaxed text-muted\">Single-door