ldren\":\"The Plusmark collections\"}],[\"$\",\"p\",null,{\"className\":\"pretty max-w-reading text-body leading-relaxed text-muted\",\"children\":\"Compare construction, choose a writing surface, fit out a particular room or start with the wall size. No collection is labelled bestselling or trending because Plusmark publishes no sales ranking.\"}],\"$undefined\"]}],\"$undefined\"]}]]}]}],[\"$\",\"$L21\",null,{\"items\":[{\"slug\":\"metallic-premium\",\"name\":\"The Metallic Premium range\",\"kind\":\"Series\",\"blurb\":\"Plusmark's heavy-duty range: high gloss marker grade HPL face, heavy-duty anodized aluminium frame and Signature Dual-Tone corners.\",\"count\":7,\"media\":{\"publicId\":\"plusmark/products/metallic-premium-ceramic-board\",\"alt\":\"Metallic Premium Ceramic Board - Metallic Premium Whiteboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Metallic Premium Ceramic Board\",\"categoryId\":\"white-boards\"},{\"slug\":\"eco-premium\",\"name\":\"The Eco Premium range\",\"kind\":\"Series\",\"blurb\":\"Marker grade HPL face on a ribbed anodized aluminium frame with ABS Dual-Tone corners, for everyday use.\",\"count\":4,\"media\":{\"publicId\":\"plusmark/products/eco-premium-chalk-board\",\"alt\":\"Eco Premium Chalk Board - Eco Premium Chalkboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Eco Premium Chalk Board\",\"categoryId\":\"chalk-boards\"},{\"slug\":\"deluxe-standard\",\"name\":\"The Deluxe Standard range\",\"kind\":\"Series\",\"blurb\":\"High gloss melamine face, deluxe anodized aluminium frame and electroplated chrome corners — the dependable everyday range.\",\"count\":8,\"media\":{\"publicId\":\"plusmark/products/deluxe-45mm-adc-notice-board-double-door\",\"alt\":\"Deluxe 45 mm ADC Notice Board (Double Door) - Deluxe Standard ADC Notice Board by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Deluxe 45 mm ADC Notice Board (Double Door)\",\"categoryId\":\"acrylic-door-cover-notice-boards\"},{\"slug\":\"eco-regular\",\"name\":\"The Eco Regular range\",\"kind\":\"Series\",\"blurb\":\"Lightweight ribbed frame with standard plastic corners, and the widest size ladder in the catalogue — 1 × 1 ft upward.\",\"count\":6,\"media\":{\"publicId\":\"plusmark/products/eco-adc-notice-board-single-door\",\"alt\":\"Eco ADC Notice Board (Single Door) - Eco Regular ADC Notice Board by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Eco ADC Notice Board (Single Door)\",\"categoryId\":\"acrylic-door-cover-notice-boards\"},{\"slug\":\"chalk-boards\",\"name\":\"Chalk boards, glare-free\",\"kind\":\"Board type\",\"blurb\":\"Plusmark's navy faces are non-reflective navy grade surfaces, made for classrooms where the back bench has to read the board.\",\"count\":8,\"media\":{\"publicId\":\"plusmark/products/deluxe-standard-magnetic-chalk-board\",\"alt\":\"Deluxe Standard Magnetic Chalk Board - Deluxe Standard Chalkboard by Plusmark\",\"width\":2000,\"height\":1600,\"source\":\"product\"},\"productName\":\"Deluxe Standard Magnetic Chalk Board\",\"categoryId\":\"chalk-boards\"},{\"slug\":\"white-boards\",\"name\":\"White boards for marker use\",\"kind\":\"Board type\",\"blurb\":\"HPL and melamine marker faces, from 1 × 1 ft desk boards to 8 × 4 ft lecture-hall boards.\",\"count\":9,\"media\":{\"publicId\":\"plusmark/products/deluxe-standard-ceramic-board\",\"alt\":\"Deluxe Standard Ceramic Board - Deluxe Standard Whiteboard by Plusmark\",\"width\":2000,\"height\":1600,\"source\":\"product\"},\"productName\":\"Deluxe Standard Ceramic Board\",\"categoryId\":\"white-boards\"},{\"slug\":\"notice-boards\",\"name\":\"Notice & display boards\",\"kind\":\"Board type\",\"blurb\":\"Cork, fabric, combination and acrylic door cover boards for corridors, staff rooms and reception.\",\"count\":7,\"media\":{\"publicId\":\"plusmark/products/deluxe-standard-notice-board\",\"alt\":\"Deluxe Standard Notice Board - Deluxe Standard Notice Board by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Deluxe Standard Notice Board\",\"categoryId\":\"notice-boards\"},{\"slug\":\"magnetic-boards\",\"name\":\"Magnetic boards\",\"kind\":\"Board type\",\"blurb\":\"Resin coated steel and ceramic steel faces that hold charts, timetables, notices and markers.\",\"count\":6,\"media\":{\"publicId\":\"plusmark/products/deluxe-standard-magnetic-board\",\"alt\":\"Deluxe Standard Magnetic Board - Deluxe Standard Whiteboard by Plusmark\",\"width\":2000,\"height\":1600,\"source\":\"product\"},\"productName\":\"Deluxe Standard Magnetic Board\",\"categoryId\":\"white-boards\"},{\"slug\":\"double-sided-boards\",\"name\":\"Double-sided boards\",\"kind\":\"Board type\",\"blurb\":\"Two writing faces on one frame — the range Plusmark shows as both side boards.\",\"count\":1,\"media\":{\"publicId\":\"plusmark/products/eco-premium-both-side-board\",\"alt\":\"Eco Premium Double-Sided Board - Eco Premium Double-Sided Board by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\"productName\":\"Eco Premium Double-Sided Board\",\"categoryId\":\"double-sided-boards\"},{\"slug\":\"ceramic-boards\",\"name\":\"Ceramic steel boards\",\"kind\":\"Board type\",\"blurb\":\"Ceramic steel / porcelain enamel surfaces — hard, non-porous, made for continuous writing and frequent cleaning.\",\"count\":3,\"media\":\"$12:props:children:0:1:props:items:5:media\",\"productName\":\"Deluxe Standard Ceramic Board\",\"categoryId\":\"white-boards\"},{\"slug\":\"classroom-writing\",\"name\":\"Classroom writing set-up\",\"kind\":\"Use\",\"blurb\":\"The boards and classroom accessories a school orders together when it fits out or refits a set of rooms.\",\"count\":8,\"media\":{\"publicId\":\"plusmark/products/metallic-premium-chalk-board\",\"alt\":\"Metallic Premium Chalk Board - Metallic Premium Chalkboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"},\