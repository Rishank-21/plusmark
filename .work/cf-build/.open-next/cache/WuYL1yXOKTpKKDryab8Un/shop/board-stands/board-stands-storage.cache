mOrderQuantity\\\":1,\\\"bulkSuggestionQuantity\\\":10,\\\"specs\\\":[{\\\"label\\\":\\\"Type\\\",\\\"value\\\":\\\"Resin Coated Steel Magnetic Chalk Board\\\"},{\\\"label\\\":\\\"Surface\\\",\\\"value\\\":\\\"Resin coated green chalk surface; accepts magnets\\\"},{\\\"label\\\":\\\"Magnetic Use\\\",\\\"value\\\":\\\"Compatible with magnetic pins, dusters, and charts\\\"},{\\\"label\\\":\\\"Design\\\",\\\"value\\\":\\\"Heavy-duty aluminium framing with Signature Dual-Tone Corners\\\"},{\\\"label\\\":\\\"Finish\\\",\\\"value\\\":\\\"Smooth green writing surface for regular chalk writing and erasing\\\"}],\\\"enquiryOnly\\\":false,\\\"needsData\\\":false,\\\"published\\\":true,\\\"featured\\\":false,\\\"createdAt\\\":\\\"2026-01-01T09:30:00.000Z\\\"},{\\\"id\\\":\\\"metallic-premium-notice-board\\\",\\\"slug\\\":\\\"metallic-premium-notice-board\\\",\\\"name\\\":\\\"Metallic Premium Notice Board\\\",\\\"categoryId\\\":\\\"notice-boards\\\",\\\"seriesId\\\":\\\"metallic-premium\\\",\\\"subcategoryIds\\\":[\\\"notice-boards-pin-up\\\"],\\\"surface\\\":\\\"2 mm Blazer Cloth\\\",\\\"frame\\\":\\\"Aluminium anodized frame, heavy-duty\\\",\\\"corners\\\":\\\"Signature Dual-Tone corners - red cap over black connector\\\",\\\"magnetic\\\":false,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"n/a\\\",\\\"surfaceKind\\\":\\\"pin-up\\\",\\\"usage\\\":\\\"Schools, colleges, corporate and government offices\\\",\\\"blurb\\\":\\\"Metallic Premium Notice Board: 2 mm Blazer Cloth · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Metallic Premium Notice Board is built on premium aluminium construction with Signature Dual-Tone Corners. A 2 mm Blazer Cloth surface holds colour for the long term over a soft, pin-friendly core made for frequent and heavy pin usage.\\\\n\\\\nIt is the highest grade of the range, designed for long-term institutional use. Available colours: Royal \\u0026 Navy Blue, Almond \\u0026 Dark Green, Red, Maroon, Light Gray and Dark Gray.\\\\n\\\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Material — Premium aluminium construction with Signature Dual-Tone Corners\\\",\\\"Surface — 2 mm Blazer Cloth with long-lasting colour retention\\\",\\\"Core — Soft pin-friendly core for frequent and heavy pin usage\\\",\\\"Durability — Highest grade, designed for long-term institutional use\\\",\\\"Colours — Royal \\u0026 Navy Blue, Almond \\u0026 Dark Green, Red, Maroon, Light Gray, Dark Gray\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/metallic-premium-notice-board\\\",\\\"alt\\\":\\\"Metallic Premium Notice Board - Metallic Premium Notice Board by Plusmark\\\",\\\"width\\\":1400,\\\"height\\\":1400,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":\\\"plusmark/videos/metallic-premium-notice-board\\\",\\\"variants\\\":[{\\\"id\\\":\\\"metallic-premium-notice-board--3-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-notice-board\\\",\\\"sku\\\":\\\"PM-MP-NOT-3X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"3-x-4-ft\\\",\\\"label\\\":\\\"3 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":91},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":4020,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-notice-board--4-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-notice-board\\\",\\\"sku\\\":\\\"PM-MP-NOT-4X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"4-x-4-ft\\\",\\\"label\\\":\\\"4 x 4 ft\\\",\\\"widthCm\\\":122,\