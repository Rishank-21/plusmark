\\\":\\\"Metallic Premium Ceramic Board\\\",\\\"categoryId\\\":\\\"white-boards\\\",\\\"seriesId\\\":\\\"metallic-premium\\\",\\\"subcategoryIds\\\":[\\\"white-boards-ceramic\\\"],\\\"surface\\\":\\\"Ceramic steel / porcelain enamel steel surface\\\",\\\"frame\\\":\\\"Aluminium frame\\\",\\\"corners\\\":\\\"Signature Dual-Tone corners - red cap over black connector\\\",\\\"magnetic\\\":false,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"ceramic\\\",\\\"surfaceKind\\\":\\\"marker\\\",\\\"usage\\\":\\\"Institutional white board (marker) or chalk board use\\\",\\\"blurb\\\":\\\"Metallic Premium Ceramic Board: Ceramic steel / porcelain enamel steel surface · Aluminium frame. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Metallic Premium Ceramic Board has a ceramic steel / porcelain enamel steel surface, available as a white board for marker writing or a chalk board for chalk writing. The hard, non-porous surface is made for continuous writing and frequent cleaning, with consistent performance over a very long product life.\\\\n\\\\nIt is finished in an aluminium frame with Signature Dual-Tone Corners. Where magnetic use is not required, the non-magnetic Metallic Premium boards are a more economical alternative with similar writing performance.\\\\n\\\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Surface — Ceramic steel / porcelain enamel steel, in white board (marker) and chalk board options\\\",\\\"Product life — Designed for very long life under regular institutional use\\\",\\\"Performance — Hard, non-porous surface for continuous writing and frequent cleaning\\\",\\\"Finish — Smooth writing surface with consistent performance over time\\\",\\\"Maintenance — Easy to clean and maintain for daily classroom use\\\",\\\"Design — Aluminium frame with Signature Dual-Tone Corners\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/metallic-premium-ceramic-board\\\",\\\"alt\\\":\\\"Metallic Premium Ceramic Board - Metallic Premium Whiteboard by Plusmark\\\",\\\"width\\\":1400,\\\"height\\\":1400,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":null,\\\"variants\\\":[{\\\"id\\\":\\\"metallic-premium-ceramic-board--3-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-ceramic-board\\\",\\\"sku\\\":\\\"PM-MP-WHI-3X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"3-x-4-ft\\\",\\\"label\\\":\\\"3 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":91},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":4020,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-ceramic-board--4-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-ceramic-board\\\",\\\"sku\\\":\\\"PM-MP-WHI-4X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"4-x-4-ft\\\",\\\"label\\\":\\\"4 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":122},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":5060,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-ceramic-board--5-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-ceramic-board\\\",\\\"sku\\\":\\\"PM-MP-WHI-5X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"5-x-4-ft\\\",\\\"label\\\":\\\"5 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":152},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":6100,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-ceramic-board--6-x-4