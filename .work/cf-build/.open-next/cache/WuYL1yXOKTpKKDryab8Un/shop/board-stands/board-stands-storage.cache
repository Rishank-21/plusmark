ith Plusmark before dispatch.\",\"description\":\"The Crystal Colour Base Clipboard has a crystal-tint acrylic base — a modern transparent colour with an elegant appeal. The rounded edge keeps the corners soft for safety and comfort.\\n\\nA chrome electroplated clip gives anti-rust protection, and the dual-cap rivet system keeps the appearance balanced and neat. It is available in two sizes.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Base — Crystal-tint acrylic with a modern transparent colour\",\"Edge — Rounded corners for safety and comfort\",\"Clip — Chrome electroplated with anti-rust protection\",\"Rivets — Dual-cap rivet system for a balanced, neat appearance\",\"Sizes — Two sizes\"],\"customisation\":null,\"media\":[{\"publicId\":\"plusmark/products/crystal-colour-base-clipboard\",\"alt\":\"Crystal Colour Base Clipboard - Clipboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"}],\"videoId\":null,\"variants\":[{\"id\":\"crystal-colour-base-clipboard--standard-size\",\"productId\":\"crystal-colour-base-clipboard\",\"sku\":\"PM-STD-CLI-STANDA\",\"size\":{\"id\":\"standard-size\",\"label\":\"Standard size\",\"widthCm\":null,\"heightCm\":null},\"priceMode\":\"fixed\",\"priceInr\":390,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"crystal-colour-base-clipboard--made-to-order\",\"productId\":\"crystal-colour-base-clipboard\",\"sku\":\"PM-STD-CLI-MADETO\",\"size\":{\"id\":\"made-to-order\",\"label\":\"Made to order\",\"widthCm\":null,\"heightCm\":null},\"priceMode\":\"fixed\",\"priceInr\":390,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null}],\"priceMode\":\"fixed\",\"gstRatePercent\":12,\"hsnCode\":null,\"minimumOrderQuantity\":1,\"bulkSu