ice-board-single-door\\\",\\\"slug\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"name\\\":\\\"Deluxe 45 mm ADC Notice Board (Single Door)\\\",\\\"categoryId\\\":\\\"acrylic-door-cover-notice-boards\\\",\\\"seriesId\\\":\\\"deluxe-standard\\\",\\\"subcategoryIds\\\":[],\\\"surface\\\":\\\"High gloss melamine writing surface\\\",\\\"frame\\\":\\\"Deluxe anodized aluminium frame\\\",\\\"corners\\\":\\\"Electroplated chrome corners\\\",\\\"magnetic\\\":false,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"n/a\\\",\\\"surfaceKind\\\":\\\"pin-up\\\",\\\"usage\\\":\\\"Lockable notice boards with transparent acrylic door covers that protect notices from dust and handling.\\\",\\\"blurb\\\":\\\"Deluxe 45 mm ADC Notice Board (Single Door): High gloss melamine writing surface · Deluxe anodized aluminium frame. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Deluxe 45 mm Acrylic Door Cover (ADC) Notice Board (Single Door) is a notice board with a single-door acrylic cover. Deluxe 45 mm triple aluminium framing provides strength, stability and long-term durability. The transparent acrylic door cover protects displayed notices from dust, moisture and handling, with a secure single-door locking system, smooth door operation and clear visibility of notices.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Surface — High gloss melamine writing surface\\\",\\\"Frame — Deluxe anodized aluminium frame\\\",\\\"Corners — Electroplated chrome corners\\\",\\\"Non-magnetic face\\\",\\\"Sizes made — 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft\\\",\\\"Custom sizes made to order\\\",\\\"Pan-India dispatch from Ahmedabad\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/deluxe-45mm-adc-notice-board-single-door\\\",\\\"alt\\\":\\\"Deluxe 45 mm ADC Notice Board (Single Door) - Deluxe Standard ADC Notice Board by Plusmark\\\",\\\"width\\\":2000,\\\"height\\\":1600,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":null,\\\"variants\\\":[{\\\"id\\\":\\\"deluxe-45mm-adc-notice-board-single-door--3-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"sku\\\":\\\"PM-DS-ACR-3X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"3-x-4-ft\\\",\\\"label\\\":\\\"3 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":91},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":2580,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-45mm-adc-notice-board-single-door--4-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"sku\\\":\\\"PM-DS-ACR-4X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"4-x-4-ft\\\",\\\"label\\\":\\\"4 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":122},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":3240,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-45mm-adc-notice-board-single-door--5-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"sku\\\":\\\"PM-DS-ACR-5X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"5-x-4-ft\\\",\\\"label\\\":\\\"5 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":152},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":3900,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-45mm-adc-notice-board-single-door--6-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"sku\\\":\\\"PM-DS-ACR-6X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"6-x-4-ft\\\",\\\"label\\\":\\\"6 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":183},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":4560,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"deluxe-45mm-adc-notice-board-single-door--8-x-4-ft\\\",\\\"productId\\\":\\\"deluxe-45mm-adc-notice-board-single-door\\\",\\\"sku\\\":\\\"PM-DS-ACR-8X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"8-x-4-ft\\\",\\\"label\\\":\\\"8 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":244},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":5880,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null}],\\\"priceMode\\\":\\\"fixed\\\",\\\"gstRatePercent\\\":12,\\\"hsnCode\\\":null,\\\"minimumOrderQuantity\\\":1,\\\"bulkSuggestionQuantity\\\":10,\\\"specs\\\":[{\\\"label\\\":\\\"Type\\\",\\\"value\\\":\\\"Acrylic door covered notice board with single door design\\\"},{\\\"label\\\":\\\"Framing\\\",\\\"value\\\":\\\"Deluxe 45 mm triple aluminium framing for strength, stability, and long-term durability\\\"},{\\\"label\\\":\\\"Cover\\\",\\\"value\\\":\\\"Transparent acrylic door cover to protect displayed notices from dust, moisture, and handling\\\"},{\\\"label\\\":\\\"Locking\\\",\\\"value\\\":\\\"Secure single-door locking system for controlled and safe notice display\\\"},{\\\"label\\\":\\\"Performance\\\",\\\"value\\\":\\\"Smooth door operation with clear visibility of notices\\\"},{\\\"label\\\":\\\"Finish\\\",\\\"value\\\":\\\"Neat and professional finish suitable for regular indoor use\\\"}],\\\"enquiryOnly\\\":false,\\\"needsData\\\":false,\\\"published\\\":true,\\\"featured\\\":false,\\\"createdAt\\\":\\\"2026-01-01T09:30:00.000Z\\\"},{\\\"id\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"slug\\\":\\\"deluxe-standard-ceramic-board\\\",\\\"name\\\":\\\"Deluxe Standard Ceramic Board\\\",\\\"categoryId\\\":\\\"white-boards\\\",\\\"seriesId\\\":\\\"deluxe-standard\\\",\\\"subcategoryIds\\\":[\\\"white-boards-ceramic\\\"],\\\"surface\\\":\\\"Ceramic steel / porcelain enamel steel surface\\\",\\\"frame\\\":\\\"Aluminium frame\\\",\\\"corners\\\":\\\"Electroplated Chrome Corners\\\",\\\"magnetic\\\":false,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"ceramic\\\",\\\"surfaceKind\\\":\\\"marker\\\",\\\"usage\\\":\\\"Institutional white board (marker) or chalk board use\\\",\\\"blurb\\\":\\\"Deluxe Standard Ceramic Board: Ceramic steel / porcelain enamel steel surface · Aluminium frame. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Deluxe Standard Ceramic Board has a ceramic steel / porcelain enamel steel surface, available as a white board for marker writing or a chalk board for chalk writing. The hard, non-porous surface suits continuous writing and frequent cleaning, with consistent performance over a very long product life.\\\\n\\\\nIt is finished in an aluminium frame with Electroplated Chrome Corners. Where magnetic use is not required, the non-magnetic Eco Premium boards are a more economical alternative with similar writing performance.\\\\n\\\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Surface — Ceramic steel / porcelain enamel steel, in white board (marker) and chalk board options\\\",\\\"Product life — Designed for very long life under regular institutional use\\\",\\\"Performance — Hard, non-porous surface for continuous writing and frequent cleaning\\\",\\\"Finish — Smooth writing surface with consistent performance over time\\\",\\\"Maintenance — Easy to clean and maintain for daily classroom use\\\",\\\"Design — Aluminium frame with Electroplate