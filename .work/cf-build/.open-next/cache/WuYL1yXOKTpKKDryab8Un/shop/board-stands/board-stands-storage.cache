metallic-premium-chalk-board\",\"slug\":\"metallic-premium-chalk-board\",\"name\":\"Metallic Premium Chalk Board\",\"categoryId\":\"chalk-boards\",\"seriesId\":\"metallic-premium\",\"subcategoryIds\":[\"chalk-boards-non-magnetic\"],\"surface\":\"Hardcore Chalk Grade HPL Sheet\",\"frame\":\"Aluminium anodized frame, heavy-duty\",\"corners\":\"Signature Dual-Tone corners - red cap over black connector\",\"magnetic\":false,\"doubleSided\":false,\"boardType\":\"non-magnetic\",\"surfaceKind\":\"chalk\",\"usage\":\"Schools, colleges, offices and institutional classrooms\",\"blurb\":\"Metallic Premium Chalk Board: Hardcore Chalk Grade HPL Sheet · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\",\"description\":\"The Metallic Premium Chalk Board uses high-quality materials with rigid core construction, finished in heavy-duty aluminium framing with Signature Dual-Tone Corners.\\n\\nIts Hardcore Chalk Grade HPL Sheet has enhanced scratch resistance and is non-reflective and glare-free, with clear visibility from all angles. It is built for intensive daily institutional use and is wall-mountable, easy to install.\\n\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Material — High-quality materials with rigid core construction\",\"Design — Heavy-duty aluminium framing with Signature Dual-Tone Corners\",\"Surface — Hardcore Chalk Grade HPL Sheet with enhanced scratch resistance; non-reflective and glare-free with clear visibility from all angles\",\"Durability — Designed for intensive daily institutional use\",\"Installation — Wall-mountable, easy to install\"],\"customisation\":null,\"media\":[{\"publicId\":\"plusmark/products/metallic-premium-chalk-board\",\"alt\":\"Metallic Premium Chalk Board - Metallic Premium Chalkboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"}],\"videoId\":\"plusmark/videos/metallic-premium-chalk-board\",\"variants\":[{\"id\":\"metallic-premium-chalk-board--3-x-4-ft\",\"productId\":\"metallic-premium-chalk-board\",\"sku\":\"PM-MP-CHA-3X4FT0\",\"size\":{\"id\":\"3-x-4-ft\",\"label\":\"3 x 4 ft\",\"widthCm\":122,\"heightCm\":91},\"priceMode\":\"fixed\",\"priceInr\":4020,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"metallic-premium-chalk-board--4-x-4-ft\",\"productId\":\"metallic-premium-chalk-board\",\"sku\":\"PM-MP-CHA-4X4FT0\",\"size\":{\"id\":\"4-x-4-ft\",\"label\":\"4 x 4 ft\",\"widthCm\":122,\"heightCm\":122},\"priceMode\":\"fixed\",\"priceInr\":5060,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"metallic-premium-chalk-board--5-x-4-ft\",\"productId\":\"metallic-premium-chalk-board\",\"sku\":\"PM-MP-CHA-5X4FT0\",\"size\":{\"id\":\"5-x-4-ft\",\"label\":\"5 x 4 ft\",\"widthCm\":122,\"heightCm\":152},\"priceMode\":\"fixed\",\"priceInr\":6100,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"metallic-premium-chalk-board--6-x-4-ft\",\"productId\":\"metallic-premium-chalk-board\",\"sku\":\"PM-MP-CHA-6X4FT0\",\"size\":{\"id\":\"6-x-4-ft\",\"label\":\"6 x 4 ft\",\"widthCm\":122,\"heightCm\":183},\"priceMode\":\"fixed\",\"priceInr\":7140,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"metallic-premium-chalk-board--8-x-4-ft\",\"productId\":\"metallic-premium-chalk-board\",\"sku\":\"PM-MP-CHA-8X4FT0\",\"size\":{\"id\":\"8-x-4-ft\",\"label\":\"8 x 4 ft\",\"widthCm\":122,\"heightCm\":244},\"priceMode\":\"fixed\",\"priceInr\":9220,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null}],\"priceMode\":\"fixed\",\"gstRatePercent\":12,\"hsnCode\":null,\"minimumOrderQuantity\":1,\"bulkSuggestionQuantity\":10,\"specs\":[{\"label\":\"Type\",\"value\":\"Non-Magnetic Chalk Board\"},{\"label\":\"Material\",\"value\":\"High-quality materials with rigid core construction\"},{\"label\":\"Design\",\"value\":\"Heavy-duty aluminium framing with Signature Dual-Tone Corners\"},{\"label\":\"Surface\",\"value\":\"Hardcore Chalk Grade HPL Sheet with enhanced scratch resistance; non-reflective, glare-free, with clear visibility from all angles\"},{\"label\":\"Durability\",\"value\":\"Designed for intensive daily institutional use\"},{\"label\":\"Installation\",\"value\":\"Wall-mountable, easy to install\"}],\"enquiryOnly\":false,\"needsData\":false,\"published\":true,\"featured\":true,\"createdAt\":\"2026-01-01T09:30:00.000Z\"},{\"id\":\"metallic-premium-magnetic-board\",\"slug\":\"metallic-premium-magnetic-board\",\"name\":\"Metallic Premium Magnetic Board\",\"categoryId\":\"white-boards\",\"seriesId\":\"metallic-premium\",\"subcategoryIds\":[\"white-boards-magnetic\"],\"surface\":\"Resin coated writing surface\",\"frame\":\"Aluminium anodized frame, heavy-duty\",\"corners\":\"Signature Dual-Tone corners - red cap over black connector\",\"magnetic\":true,\"doubleSided\":false,\"boardType\":\"magnetic\",\"surfaceKind\":\"marker\",\"usage\":\"Marker or chalk writing with magnetic accessories\",\"blurb\":\"Metallic Premium Magnetic Board: Resin coated writing surface · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\",\"description\":\"The Metallic Premium Magnetic Board has a resin-coated writing surface suitable for marker (white) and chalk (green) boards. It accepts magnetic accessories such as magnets, charts and holders.\\n\\nHeavy-duty aluminium framing with Signature Dual-Tone Corners holds a smooth writing surface for regular writing and erasing. For heavy chalk usage without a magnetic requirement, Plusmark recommends the non-magnetic premium or ceramic boards for longer surface life.\\n\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\n\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\",\"features\":[\"Surface — Resin coated writing surface suitable for marker (white) and chalk (green) boards\",\"Magnetic use — Compatible with magnets, charts and holders\",\"Design — Heavy-duty aluminium framing with Signature Dual-Tone Corners\",\"Finish — Smooth writing surface for regular writing and erasing\"],\"customisation\":null,\"media\":[{\"publicId\":\"plusmark/products/metallic-premium-magnetic-board\",\"alt\":\"Metallic Premium Magnetic Board - Metallic Premium Whiteboard by Plusmark\",\"width\":1400,\"height\":1400,\"source\":\"product\"}],\"videoId\":null,\"variants\":[{\"id\":\"metallic-premium-magnetic-board--3-x-4-ft\",\"productId\":\"metallic-premium-magnetic-board\",\"sku\":\"PM-MP-WHI-3X4FT0\",\"size\":{\"id\":\"3-x-4-ft\",\"label\":\"3 x 4 ft\",\"widthCm\":122,\"heightCm\":91},\"priceMode\":\"fixed\",\"priceInr\":4020,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"id\":\"metallic-premium-magnetic-board--4-x-4-ft\",\"productId\":\"metallic-premium-magnetic-board\",\"sku\":\"PM-MP-WHI-4X4FT0\",\"size\":{\"id\":\"4-x-4-ft\",\"label\":\"4 x 4 ft\",\"widthCm\":122,\"heightCm\":122},\"priceMode\":\"fixed\",\"priceInr\":5060,\"compareAtInr\":null,\"stock\":null,\"trackInventory\":false,\"available\":true,\"leadTimeDays\":null},{\"i