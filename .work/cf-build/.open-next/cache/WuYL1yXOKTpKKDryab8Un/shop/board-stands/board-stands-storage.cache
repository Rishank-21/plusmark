se,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-chalk-board--8-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-chalk-board\\\",\\\"sku\\\":\\\"PM-MP-CHA-8X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"8-x-4-ft\\\",\\\"label\\\":\\\"8 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":244},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":9220,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null}],\\\"priceMode\\\":\\\"fixed\\\",\\\"gstRatePercent\\\":12,\\\"hsnCode\\\":null,\\\"minimumOrderQuantity\\\":1,\\\"bulkSuggestionQuantity\\\":10,\\\"specs\\\":[{\\\"label\\\":\\\"Type\\\",\\\"value\\\":\\\"Non-Magnetic Chalk Board\\\"},{\\\"label\\\":\\\"Material\\\",\\\"value\\\":\\\"High-quality materials with rigid core construction\\\"},{\\\"label\\\":\\\"Design\\\",\\\"value\\\":\\\"Heavy-duty aluminium framing with Signature Dual-Tone Corners\\\"},{\\\"label\\\":\\\"Surface\\\",\\\"value\\\":\\\"Hardcore Chalk Grade HPL Sheet with enhanced scratch resistance; non-reflective, glare-free, with clear visibility from all angles\\\"},{\\\"label\\\":\\\"Durability\\\",\\\"value\\\":\\\"Designed for intensive daily institutional use\\\"},{\\\"label\\\":\\\"Installation\\\",\\\"value\\\":\\\"Wall-mountable, easy to install\\\"}],\\\"enquiryOnly\\\":false,\\\"needsData\\\":false,\\\"published\\\":true,\\\"featured\\\":true,\\\"createdAt\\\":\\\"2026-01-01T09:30:00.000Z\\\"},{\\\"id\\\":\\\"metallic-premium-magnetic-board\\\",\\\"slug\\\":\\\"metallic-premium-magnetic-board\\\",\\\"name\\\":\\\"Metallic Premium Magnetic Board\\\",\\\"categoryId\\\":\\\"white-boards\\\",\\\"seriesId\\\":\\\"metallic-premium\\\",\\\"subcategoryIds\\\":[\\\"white-boards-magnetic\\\"],\\\"surface\\\":\\\"Resin coated writing surface\\\",\\\"frame\\\":\\\"Aluminium anodized frame, heavy-duty\\\",\\\"corners\\\":\\\"Signature Dual-Tone corners - red cap over black connector\\\",\\\"magnetic\\\":true,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"magnetic\\\",\\\"surfaceKind\\\":\\\"marker\\\",\\\"usage\\\":\\\"Marker or chalk writing with magnetic accessories\\\",\\\"blurb\\\":\\\"Metallic Premium Magnetic Board: Resin coated writing surface · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Metallic Premium Magnetic Board has a resin-coated writing surface suitable for marker (white) and chalk (green) boards. It accepts magnetic accessories such as magnets, charts and holders.\\\\n\\\\nHeavy-duty aluminium framing with Signature Dual-Tone Corners holds a smooth writing surface for regular writing and erasing. For heavy chalk usage without a magnetic requirement, Plusmark recommends the non-magnetic premium or ceramic boards for longer surface life.\\\\n\\\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Surface — Resin coated writing surface suitable for marker (white) and chalk (green) boards\\\",\\\"Magnetic use — Compatible with magnets, charts and holders\\\",\\\"Design — Heavy-duty aluminium framing with Signature Dual-Tone Corners\\\",\\\"Finish — Smooth writing surface for regular writing and erasing\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/metallic-premium-magnetic-board\\\",\\\"alt\\\":\\\"Metallic Premium Magnetic Board - Metallic Premium Whiteboard by Plusmark\\\",\\\"width\\\":1400,\\\"height\\\":1400,\\\"source\\\":\\\"product\\\"}],\\\"videoId\\\":null,\\\"variants\\\":[{\\\"id\\\":\\\"metallic-premium-magneti