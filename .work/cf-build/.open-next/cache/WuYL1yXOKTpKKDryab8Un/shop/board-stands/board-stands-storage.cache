able\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-ceramic-chalk-board--6-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-ceramic-chalk-board\\\",\\\"sku\\\":\\\"PM-MP-CHA-6X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"6-x-4-ft\\\",\\\"label\\\":\\\"6 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":183},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":7140,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null},{\\\"id\\\":\\\"metallic-premium-ceramic-chalk-board--8-x-4-ft\\\",\\\"productId\\\":\\\"metallic-premium-ceramic-chalk-board\\\",\\\"sku\\\":\\\"PM-MP-CHA-8X4FT0\\\",\\\"size\\\":{\\\"id\\\":\\\"8-x-4-ft\\\",\\\"label\\\":\\\"8 x 4 ft\\\",\\\"widthCm\\\":122,\\\"heightCm\\\":244},\\\"priceMode\\\":\\\"fixed\\\",\\\"priceInr\\\":9220,\\\"compareAtInr\\\":null,\\\"stock\\\":null,\\\"trackInventory\\\":false,\\\"available\\\":true,\\\"leadTimeDays\\\":null}],\\\"priceMode\\\":\\\"fixed\\\",\\\"gstRatePercent\\\":12,\\\"hsnCode\\\":null,\\\"minimumOrderQuantity\\\":1,\\\"bulkSuggestionQuantity\\\":10,\\\"specs\\\":[{\\\"label\\\":\\\"Type\\\",\\\"value\\\":\\\"Ceramic Steel Magnetic Chalk Board\\\"},{\\\"label\\\":\\\"Surface\\\",\\\"value\\\":\\\"Ceramic steel / porcelain enamel green chalk surface; accepts magnets\\\"},{\\\"label\\\":\\\"Product Life\\\",\\\"value\\\":\\\"Designed for very long product life under regular institutional use\\\"},{\\\"label\\\":\\\"Design\\\",\\\"value\\\":\\\"Aluminium frame with Signature Dual-Tone Corners\\\"}],\\\"enquiryOnly\\\":false,\\\"needsData\\\":false,\\\"published\\\":true,\\\"featured\\\":false,\\\"createdAt\\\":\\\"2026-01-01T09:30:00.000Z\\\"},{\\\"id\\\":\\\"metallic-premium-chalk-board\\\",\\\"slug\\\":\\\"metallic-premium-chalk-board\\\",\\\"name\\\":\\\"Metallic Premium Chalk Board\\\",\\\"categoryId\\\":\\\"chalk-boards\\\",\\\"seriesId\\\":\\\"metallic-premium\\\",\\\"subcategoryIds\\\":[\\\"chalk-boards-non-magnetic\\\"],\\\"surface\\\":\\\"Hardcore Chalk Grade HPL Sheet\\\",\\\"frame\\\":\\\"Aluminium anodized frame, heavy-duty\\\",\\\"corners\\\":\\\"Signature Dual-Tone corners - red cap over black connector\\\",\\\"magnetic\\\":false,\\\"doubleSided\\\":false,\\\"boardType\\\":\\\"non-magnetic\\\",\\\"surfaceKind\\\":\\\"chalk\\\",\\\"usage\\\":\\\"Schools, colleges, offices and institutional classrooms\\\",\\\"blurb\\\":\\\"Metallic Premium Chalk Board: Hardcore Chalk Grade HPL Sheet · Aluminium anodized frame, heavy-duty. Made to order in the sizes listed here; confirm the exact specification with Plusmark before dispatch.\\\",\\\"description\\\":\\\"The Metallic Premium Chalk Board uses high-quality materials with rigid core construction, finished in heavy-duty aluminium framing with Signature Dual-Tone Corners.\\\\n\\\\nIts Hardcore Chalk Grade HPL Sheet has enhanced scratch resistance and is non-reflective and glare-free, with clear visibility from all angles. It is built for intensive daily institutional use and is wall-mountable, easy to install.\\\\n\\\\nStandard sizes on this page are 3 x 4 ft, 4 x 4 ft, 5 x 4 ft, 6 x 4 ft, 8 x 4 ft. Larger or non-standard sizes are made to order — send the size you need and the team will quote it.\\\\n\\\\nPrices depend on series, size and quantity, so Plusmark confirms the figure for your exact requirement instead of publishing a list price. There is no minimum order — a single board can go straight in the cart.\\\",\\\"features\\\":[\\\"Material — High-quality materials with rigid core construction\\\",\\\"Design — Heavy-duty aluminium framing with Signature Dual-Tone Corners\\\",\\\"Surface — Hardcore Chalk Grade HPL Sheet with enhanced scratch resistance; non-reflective and glare-free with clear visibility from all angles\\\",\\\"Durability — Designed for intensive daily institutional use\\\",\\\"Installation — Wall-mountable, easy to install\\\"],\\\"customisation\\\":null,\\\"media\\\":[{\\\"publicId\\\":\\\"plusmark/products/metal