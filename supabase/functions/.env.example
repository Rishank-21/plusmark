# Copy to supabase/functions/.env.local (git-ignored). Used by `npm run backend:functions`.

# Razorpay. Use rzp_test_* keys until the account is live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Settings > Webhooks. URL: https://<project-ref>.supabase.co/functions/v1/razorpay-webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Resend (free: 3,000 emails/month, 100/day). Until you verify a domain you can only send
# from onboarding@resend.dev to the email address you signed up with.
RESEND_API_KEY=re_xxxxxxxx
NOTIFICATION_FROM_EMAIL=Plusmark <onboarding@resend.dev>

# Shared secret between the database and the process-emails function (16+ chars, random).
NOTIFICATION_JOB_SECRET=generate-a-random-32-char-string

# Links inside emails
SITE_URL=http://localhost:3000

# Comma separated browser origins allowed to call payment functions (empty = any)
STOREFRONT_ORIGINS=https://your-store.example
# Local testing only
ALLOW_LOCALHOST_ORIGINS=true
