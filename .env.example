# Supabase public configuration (safe for the browser)
# The anon key and the newer "publishable" key are interchangeable here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Optional feature flags
# Theme/accent preview switcher. On by default; set "off" to hide it in production.
# NEXT_PUBLIC_THEME_PREVIEW=off
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=on
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_B2B_SITE_URL=https://plusmarkboards.com
# NEXT_PUBLIC_DEMO_PRICING=off

# Server-only credentials for local tooling (migrations, type generation).
# Never prefix these with NEXT_PUBLIC_ and never import them in client code.
# SUPABASE_SECRET_KEY=
# SUPABASE_DATABASE_URL=
# SUPABASE_DATABASE_PASSWORD=

# Cloudinary (files live on Cloudinary; Postgres stores metadata only).
# The cloud name is public and is embedded in delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only credentials used by /api/media/sign and /api/media/delete.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: only if an unsigned preset is used instead of signed uploads.
# CLOUDINARY_UPLOAD_PRESET=
# Folder prefix for every upload. Defaults to "plusmark".
CLOUDINARY_BASE_FOLDER=plusmark
# Optional: only for scripts/migrate-media-to-cloudinary.mjs --remote, when the
# catalogue still lives on an older Cloudinary cloud. Defaults to drt0rpkn2.
# LEGACY_CLOUDINARY_CLOUD_NAME=

# Razorpay (server only). Use rzp_test_* keys until the account is live.
# The checkout page receives only the key id; the secret never leaves the server.
RAZORPAY_API_KEY=
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard → Settings → Webhooks, endpoint:
# https://<your-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
